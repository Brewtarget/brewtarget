#ifndef CONFIG_IN
#define CONFIG_IN
#pragma once

/**
 * This file gets converted to mbuild/config.h by Meson (see configure_file command in meson.build in top-level
 * directory)
 *
 * (Note that src/config.in serves the same purpose for CMake builds and should be retired if/when we stop using CMake.)
 *
 * This is a way to pass Meson variables into the code.
 *
 * NOTE: if you change one of the config values (eg in meson.build), you will want to do a full build to make sure the
 *       new value appears everywhere it is used.
 */

//! Used on Linux as a fallback way of determining where to look for resources - see Application.cpp
constexpr char const * CONFIG_DATA_DIR            = "@CONFIG_DATA_DIR@";

// These constants make sharing code between Brewtarget and Brewken slightly easier
// (Here, UC means upper case first letter, LC means lower case first letter)
constexpr char const * CONFIG_APPLICATION_NAME_UC = "@CONFIG_APPLICATION_NAME_UC@";
constexpr char const * CONFIG_APPLICATION_NAME_LC = "@CONFIG_APPLICATION_NAME_LC@";
constexpr char const * CONFIG_ORGANIZATION_DOMAIN = "@CONFIG_ORGANIZATION_DOMAIN@";

//
// In a couple of places we have code that intentionally differs between Brewken and Brewtarget -- eg for file
// locations.  ()So the string constants above are not enough.)  In the past this was a source of errors when merging
// fixes back and forth between the two code bases.  So we now use #ifdefs to have both versions in both projects and
// conditionally compile the one we want.  _AC stands for "all upper case".  We should have either BUILDING_BREWKEN or
// BUILDING_BREWTARGET defined, but not both.  We check this with the magic of XOR (^) below.
//
#define BUILDING_@CONFIG_APPLICATION_NAME_AC@
#if !(defined(BUILDING_BREWKEN) ^ defined(BUILDING_BREWTARGET))
   #error "Exactly one of BUILDING_BREWKEN or BUILDING_BREWTARGET must be defined"
#endif

/**
 * Sometimes it is useful to have #define versions of constants for compile-time string concatenation with the
 * preprocessor.  (TBD: It is possible to do this with templates -- eg see
 * https://stackoverflow.com/questions/38955940/how-to-concatenate-static-strings-at-compile-time -- so we might retire
 * these \c #defines at some point.)
 */
#define DEF_CONFIG_APPLICATION_NAME_LC "@CONFIG_APPLICATION_NAME_LC@"
#define DEF_CONFIG_MIME_PREFIX "application/x-@CONFIG_APPLICATION_NAME_LC@"

// This one has to be a #define rather than a constexpr because it's used in ui/mainWindow.ui which is processed into
// C++ code by the Qt Meta Object Compiler (MOC) and the MOC can't handle use of a constexpr const in a ui file.
#define CONFIG_VERSION_STRING "@CONFIG_VERSION_STRING@"

// Build info
constexpr char const * CONFIG_BUILD_SYSTEM    = "@CONFIG_BUILD_SYSTEM@";
constexpr char const * CONFIG_RUN_SYSTEM      = "@CONFIG_RUN_SYSTEM@";
constexpr char const * CONFIG_CXX_COMPILER_ID = "@CONFIG_CXX_COMPILER_ID@";
constexpr char const * CONFIG_BUILD_TIMESTAMP = "@CONFIG_BUILD_TIMESTAMP@";

// Support info
constexpr char const * CONFIG_GITHUB_URL      = "@CONFIG_GITHUB_URL@";
constexpr char const * CONFIG_WEBSITE_URL     = "@CONFIG_WEBSITE_URL@";

// Data files for unit tests
constexpr char const * CONFIG_TEST_DATA_DIR   = "@CONFIG_TEST_DATA_DIR@";

#endif