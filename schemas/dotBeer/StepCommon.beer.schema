{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/1.0.0/StepCommon.beer.schema",
  "description": "`StepCommon` is not a type itself, but a subschema holding various common parts of `MashStep`, `BoilStep` and `FermentationStep`.",
  "$defs": {
    //
    // The step types have overlapping sets of fields, as follows (where ‡ means a field is required):
    //
    // NB: In BeerJSON, the mash step's start temperature is called `step_temperature`.
    //
    //    MashStep             BoilStep            FermentationStep    |   Provided By
    //    --------             --------            ----------------    |   -----------
    //  ‡ name               ‡ name              ‡ name                |   StepBase
    //    step_description     step_description    step_description    |   StepBase
    //    ramp_time            ramp_time                               |   StepWithRampTime
    //  ‡ step_time            step_time           step_time           |   StepBase
    //  ‡ start_temperature    start_temperature   start_temperature   |   StepBase
    //    end_temperature      end_temperature     end_temperature     |   StepBase
    //    start_pH             start_pH            start_pH            |   StepBase
    //    end_pH               end_pH              end_pH              |   StepBase
    //                         start_gravity       start_gravity       |   StepWithGravity
    //                         end_gravity         end_gravity         |   StepWithGravity
    //                                                                 |
    //  ‡ step_type                                                    |   MashStep
    //    amount                                                       |   MashStep
    //    water_grain_ratio                                            |   MashStep
    //    infuse_temperature                                           |   MashStep
    //                                                                 |
    //                         chilling_type                           |   BoilStep
    //                                                                 |
    //                                             free_rise           |   FermentationStep
    //                                             vessel              |   FermentationStep
    //                                             vessel_pressure     |   FermentationStep
    //
    "StepBase": {
      "type": "object",
      "description": "Common attributes of MashStep, BoilStep and FermentationStep.",
      "properties": {
        "name": {
          "description": "A short label for the step, eg \"Dough In\", \"Conversion\" or \"Whirlpool\".",
          "type": "string"
        },
        "step_description": {
          "description": "A description of the step for the brewer to read, eg \"Infuse 15 L of water at 72°C\".  This may be entered by the user or generated by the program.  It is for information only: readers should not try to extract data from it.",
          "type": "string"
        },
        "step_time": {
          "description": "The duration to spend at this step – ie the amount of time we are to hold this particular step temperature.",
          "$ref": "Measurement.beer.schema#/$defs/Time"
        },
        "start_temperature": {
          "description": "For a MashStep this is also known as the step temperature, and is the target temperature for this step",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
        "end_temperature": {
          "description": "Temperature at the end of the step, eg after the mash cools naturally during a long rest.",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
        "start_pH": {
          "description": "The pH at the start of the step.",
          "$ref": "Measurement.beer.schema#/$defs/Acidity"
        },
        "end_pH": {
          "description": "The pH at the end of the step.",
          "$ref": "Measurement.beer.schema#/$defs/Acidity"
        }
      },
      "required": [
        "name"
      ]
    },
    "StepWithRampTime": {
      "type": "object",
      "description": "Common attribute of MashStep and BoilStep but not FermentationStep.",
      "properties": {
        "ramp_time": {
          "description": "The amount of time that passes before this step begins.  Eg moving from a mash step (step 1) of 148°F, to a new temperature step of 156°F (step 2) may take 8 minutes to heat the mash. Step 2 would have a ramp time of 8 minutes.",
          "$ref": "Measurement.beer.schema#/$defs/Time"
        }
      }
    },
    "StepWithGravity": {
      "type": "object",
      "description": "Common attributes of BoilStep and FermentationStep but not MashStep.",
      "properties": {
        "start_gravity": {
          "description": "The gravity at the start of the step.",
          "$ref": "Measurement.beer.schema#/$defs/Gravity"
        },
        "end_gravity": {
          "description": "The gravity at the end of the step, eg a fermentation step might last until the gravity reaches 1.012 (rather than for a set time).",
          "$ref": "Measurement.beer.schema#/$defs/Gravity"
        }
      }
    }
  }
}