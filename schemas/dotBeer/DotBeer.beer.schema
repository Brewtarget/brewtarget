{
  //
  // NB: We reserve plurals for where multiple elements are required.  Thus, "Hop" and "Fermentable" are singular
  //     (because they are classifiers) but "hops" and "fermentables" are plural (because they are lists of things).
  //
  //     Similarly, CamelCase is for types (eg FolderPath) and snake_case is for properties (eg folder_path).  We make
  //     one minor exception to the latter for pH, the measure of acidity, because IMHO it improves readability to write
  //     beer_pH, start_pH, end_pH etc rather than beer_ph, start_ph, end_ph.
  //
  //     For enum values, we have a mixture of snake_case (eg `add_to_mash`, `add_to_boil`, etc) and separate words (eg
  //     `partial mash`, `all grain`).  This is, except where we have good reason to do otherwise, we follow BeerJSON
  //     enum values.  (Keeping the same enum values between BeerJSON and dotBeer gives us some minor code
  //     simplifications in Brewken/Brewtarget.)
  //
  //     In "description" fields, we mostly use \n for linebreaks, but there are places where <br> gives better output
  //     in the generated .md files (because \n would give no linebreak and \n\n would give too much interline spacing).
  //     (Depending on which tool you are using to view the .md files, YMMV.)
  //
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  //
  // This is not a "real" URL.  The "directory" above the filename is the version of the dotBeer schema.
  // Versions prior to 1.0.0 are subject to breaking changes!
  //
  "$id": "https://dotbeer.org/schema/0.10.0/DotBeer.beer.schema",
  "type": "object",
  "title": "DotBeer File Format",
  "description": "A free and open serialisation format for beer recipes, ingredients and related data",
  "properties": {
    //
    // Having a root element such as this is not strictly necessary, but it is useful to provide context, showing that
    // the file contents are dotBeer format, even if the file extension got changed or is unavailable.
    //
    "DotBeer": {
      "type": "object",
      "description": "Root element of all dotBeer documents.  Most of the Primary Types (ie ones that have their own schema file) are referred to here.  Various Component Types (ie smaller types used for composition) are defined in the \"$defs\" sections of most of the schema files (apart from this one).",
      "properties": {
        "version": {
          "description": "DotBeer schema version used to create the file.",
          "$ref": "#/$defs/VersionNumber"
        },
        "output_by": {
          "description": "Application that wrote the file -- eg Brewtarget 5.2.1.",
          "type": "string"
        },
        "timestamp": {
          "description": "Date and time file was created.",
          "$ref": "Measurement.beer.schema#/$defs/DateTimeOffset"
        },
        // Ingredients
        "hops": {
          "type": "array",
          "description": "Records detailing properties of unique hop varieties.",
          "items": {
            "$ref": "Hop.beer.schema"
          }
        },
        "fermentables": {
          "type": "array",
          "description": "Records for any ingredient that contributes to the gravity of the beer.",
          "items": {
            "$ref": "Fermentable.beer.schema"
          }
        },
        "miscs": {
          "type": "array",
          "description": "Records for ingredients that are not hops, fermentables or cultures.  Variously known as \"miscellaneous ingredients\", \"non-fermentable adjuncts\", \"other ingredients\", or \"adjuncts that do not contribute to the gravity of the beer\".",
          "items": {
            "$ref": "Misc.beer.schema"
          }
        },
        "cultures": {
          "type": "array",
          "description": "Records detailing the wide array of unique cultures.",
          "items": {
            "$ref": "Culture.beer.schema"
          }
        },
        "waters": {
          //
          // Water is different from other ingredients, in that it doesn't have inventory and its additions are (mostly)
          // defined in the mash steps.
          //
          "type": "array",
          "description": "Records for water profiles used in brewing.",
          "items": {
            "$ref": "Water.beer.schema"
          }
        },
        // Processes
        "mashes": {
          "type": "array",
          "description": "Common mashing procedures.",
          "items": {
            "$ref": "Mash.beer.schema"
          }
        },
        "boils": {
          "type": "array",
          "description": "Common boil procedures.",
          "items": {
            "$ref": "Boil.beer.schema"
          }
        },
        "fermentations": {
          "type": "array",
          "description": "Common fermentation procedures.",
          "items": {
            "$ref": "Fermentation.beer.schema"
          }
        },
        //
        // BeerJSON has packaging here (eg what size bottles you're going to put your beer in), but we omit this from
        // dotBeer as it's not (currently) something we deal with in Brewken/Brewtarget.
        //
        // Other objects
        "styles": {
          "type": "array",
          "description": "Details of judging guidelines for individual beer styles.",
          "items": {
            "$ref": "Style.beer.schema"
          }
        },
        "equipments": {
          "type": "array",
          "description": "Provides necessary information for brewing equipment.",
          "items": {
            "$ref": "Equipment.beer.schema"
          }
        },
        "recipes": {
          "type": "array",
          "description": "Records containing a minimal collection of the description of ingredients, procedures and other required parameters necessary to recreate a batch of beer.",
          "items": {
            "$ref": "Recipe.beer.schema"
          }
        },
        //
        // Although they _could_ be put inside the ingredient schemas (eg StockPurchaseHop inside Hop), we deliberately
        // choose a looser coupling to make file processing easier.  Specifically, since recipes refer to ingredients,
        // styles, equipments and so on, it's easiest to read recipes in after the things to which they refer.  Since
        // stock purchases refer to ingredients and recipes, it's easiest to read them in after reading in recipes (and
        // ingredients).
        //
        "culture_stock_purchases": {
          "type": "array",
          "description": "Records of acquisitions of stock of a culture (eg yeast), and of what was subsequently done with that stock.  Each refers, by local ID, to an item in the \"cultures\" section of the same dotBeer file.",
          "items": {
            "$ref": "StockPurchase.beer.schema#/$defs/StockPurchaseCulture"
          }
        },
        "fermentable_stock_purchases": {
          "type": "array",
          "description": "Records of acquisitions of stock of a fermentable, and of what was subsequently done with that stock.  Each refers, by local ID, to an item in the \"fermentables\" section of the same dotBeer file.",
          "items": {
            "$ref": "StockPurchase.beer.schema#/$defs/StockPurchaseFermentable"
          }
        },
        "hop_stock_purchases": {
          "type": "array",
          "description": "Records of acquisitions of stock of a hop, and of what was subsequently done with that stock.  Each refers, by local ID, to an item in the \"hops\" section of the same dotBeer file.",
          "items": {
            "$ref": "StockPurchase.beer.schema#/$defs/StockPurchaseHop"
          }
        },
        "misc_stock_purchases": {
          "type": "array",
          "description": "Records of acquisitions of stock of a miscellaneous ingredient, and of what was subsequently done with that stock.  Each refers, by local ID, to an item in the \"miscs\" section of the same dotBeer file.",
          "items": {
            "$ref": "StockPurchase.beer.schema#/$defs/StockPurchaseMisc"
          }
        }
      },
      "required": [
        "version",
        "output_by",
        "timestamp"
      ],
      //
      // Allowing additional properties would make it easier to extend the schema in a way that allows old versions of
      // software to read newer versions of dotBeer files.  However, it would also make it harder to validate things.
      // Eg if a program accidentally wrote optional parameter "foobar" with key "barfoo", it wouldn't be picked up by
      // schema validation if additional properties are allowed.  So, in general, we forbid unspecified properties.
      // Here, and elsewhere, `"unevaluatedProperties": false` is the newer, and more robust, way to do this (replacing
      // `"additionalProperties": false`).
      //
      // NOTE that we cannot use `"unevaluatedProperties": false` inside a "base" schema -- ie one that we will combine
      // with others using `allOf`.  Eg, suppose we have the following "top-level" schema (ie one that will not itself
      // be combined with others using `allOf`:
      //
      //    "allOf": [
      //      {
      //        "$ref": "#/$defs/Foo"
      //      },
      //      {
      //        "$ref": "#/$defs/Bar"
      //      },
      //      ...
      //    ]
      //
      // We are fine to have `"unevaluatedProperties": false` after the allOf, but we can't have it inside the Foo or
      // Bar schemas.  If we do, evaluation against Foo will fail because of the presence of Bar's properties, and
      // evaluation against Bar will fail because of the presence of Foo's properties.
      //
      "unevaluatedProperties": false
    },
    "$schema": {
      "description": "It is not required or expected to include this field in a dotBeer file.  However, some editors (eg VS Code) use it to find the schema against which to validate the file, and so provide autocompletion and error highlighting, so we allow it to be set.  If it is present, it should be the URL of the dotBeer root schema for the version the file was written with, ie \"https://dotbeer.org/schema/X.Y.Z/DotBeer.beer.schema\" where X.Y.Z is the value of `version`.  (Some editors also accept a local file path to a copy of the schema.)\n\nNOTE that it should *not* be the JSON Schema metaschema URL (\"https://json-schema.org/draft/2020-12/schema\").  That would tell such editors to validate the file as if it were itself a JSON Schema.",
      "type":"string"
    }
  },
  "required": [
    "DotBeer"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    //
    // There are a couple of things that don't really belong in Measurement.  At the moment, at least, it seems overkill
    // to create dedicated schema file(s) for them.  So, they live here.
    //
    "FolderPath": {
      "type": "string",
      "description": "A FolderPath is typically used for the suggested slash-delimited subfolder path in which to store an object.  Any leading slash should be ignored.  Eg, if an object's folder path is \"/hum/bug\" (or \"hum/bug\") then importing the object into folder \"/foo/bar\" should result in its folder path being \"/foo/bar/hum/bug\".  If the importing software does not support folders, then it should ignore folder path fields.",
      //
      // The regular expression here is a bit convoluted so that it allows leading slashes but not trailing ones (other
      // than the trivial case of "/").
      //
      // Each segment (ie the text between slashes) must contain at least one character that is neither a space nor a
      // control character, and must not contain any control characters at all.  Control characters are the C0 controls
      // (U+0000–U+001F, which includes tab and newline), DEL (U+007F) and the C1 controls (U+0080–U+009F).  So a segment
      // is:
      //
      //    [ ]*                             zero or more (leading) spaces
      //    [^/ \x00-\x1F\x7F-\x9F]          one character that is not a slash, space or control character
      //    [^/\x00-\x1F\x7F-\x9F]*          zero or more characters that are not a slash or control character
      //
      // We use \xHH rather than \uHHHH escapes because the latter are not supported by all regex engines (eg PCRE2, which
      // is used by Blaze, does not understand \uHHHH by default).
      //
      "pattern": "^[/]?([ ]*[^/ \\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*([/][ ]*[^/ \\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*)*)?$",
      //
      // Although it isn't intended that a FolderPath ever be translated to a filesystem path, it feels like best
      // practice to protect any future importer that does map folder paths onto a real filesystem.  We therefore
      // prohibit a segment that is exactly "." or "..", so that a filesystem-mapping importer is not tricked into
      // writing outside the intended folder.  (Names that merely contain dots, eg "...", ".hidden" or "a..b", are
      // fine.)
      //
      "not": {
        "pattern": "(^|[/])[.]{1,2}([/]|$)"
      }
    },
    "LocalId": {
      "type": "string",
      "description": "A string that, within a dotBeer file, uniquely identifies something (eg hop, fermentable, style, mash) that is used in a recipe in that same file.  Thus, for example, if each hop in the file defines its own local ID, then, for the hop additions in any recipe in the same file, it suffices to use the relevant local ID to identify the hop being added.\n\nNo two items in a single file should have the same local ID, even if they are of different types.  (This is to make reading files simpler, as a single look-up map can be used for all different types.)  The string has no meaning in any wider scope: it is a cross-reference rather than a true attribute.  Local IDs simplify the structure of dotBeer and help reduce repetition within the files.\n\nThe JSON Schema cannot validate that local IDs are correct - merely that they adhere to a particular format.  Implementing programs should therefore validate that (a) all defined local IDs in a file are unique in that file, (b) all referred-to local IDs are defined elsewhere in the file, and (c) any referred-to local ID is for an object of the relevant type (eg the local ID for the style of a recipe must be that of a style).\n\nNOTE: If you are merging two or more dotBeer files, you will first need to ensure that there are no Local ID clashes in them.",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "VersionNumber": {
      "type": "string",
      "description": "We use semantic versioning, which encodes a version by a three-part version number (Major.Minor.Patch)",
      //
      // As elsewhere, we use [0-9] rather than \\d here because, in Python at least, it matches Eastern Arabic numerals
      // such as '٣' and '٩' (see https://en.wikipedia.org/wiki/Eastern_Arabic_numerals).
      //
      // Also, the regexp here leans towards simplicity rather than completeness.  Eg it allows 1.00000002.03, which
      // isn't something you'd ever use in practice.
      //
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    }
  }
}