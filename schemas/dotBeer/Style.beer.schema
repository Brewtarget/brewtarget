{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.9.0/Style.beer.schema",
  "type": "object",
  "description": "A beer style may be from the BJCP style guide, Australian, UK or local style guides.  Generally a recipe is designed to one style.",
  "properties": {
    "name": {
      "description": "Name of the style profile – usually this is the specific name of the style – for example “Scottish Wee Heavy Ale” and not the Category which in this case might be “Scottish Ale”",
      "type": "string"
    },
    "category": {
      "description": "Category that this style belongs to – usually associated with a group of styles such as “English Ales” or “American Lagers”.",
      "type": "string"
    },
    "category_number": {
      "description": "Number or identifier associated with this style category. For example in the BJCP style guide, the “American Lager” category has a category number of “1”.  Despite the name, this needs to be a string rather than, say, an integer, because it can contain letters.  Eg BJCP mead and cider categories are M1–M4 and C1–C2.",
      "type": "string"
    },
    "style_letter": {
      // In contrast with BeerJSON, we do not allow the style letter to be a space.  If no style letter is set, this
      // field should simply be omitted.
      "description": "The specific subcategory letter associated with this particular style. For example in the BJCP style guide, an American Standard Lager would be style letter “A” under the main category.  Letters should be upper case.",
      "type": "string",
      "maxLength": 1,
      "minLength": 1,
      "pattern": "[A-Z]"
    },
    "style_guide": {
      "description": "The name of the style guide that this particular style or category belongs to. For example “BJCP” might denote the BJCP style guide, and “AHA” would be used for the AHA style guide.",
      "type": "string"
    },
    "style_type": {
      "description": "Defines the type of beverage associated with this category.",
      "enum": [
        "beer",
        "cider",
        "kombucha",
        "mead",
        "other",
        "soda",
        "wine"
      ]
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this style.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Style object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "original_gravity": {
      "description": "The range of acceptable original gravity for the style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfGravity"
    },
    "final_gravity": {
      "description": "The range of acceptable final gravity for the style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfGravity"
    },
    //
    // Strictly speaking IBUs (international bitterness units) are not what is being measured by the units used to do
    // so.  However, IBU is the only widely-used unit, and it is common parlance amongst brewers to talk about the IBU
    // of a beer rather than bitterness.  (Eg the BJCP guidelines’ Vital Statistics list “IBUs” alongside OG, FG, SRM
    // and ABV.)  In any case, the "strictly-correct" name would not be "bitterness" or even "perceived_bitterness", as
    // what is actually measured is iso-alpha acid content.  And you almost never hear brewers saying "Would you say
    // that's within the iso-alpha acid content range for this style?" :)
    //
    "ibu": {
      "description": "The range of bitterness for this style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfBitterness"
    },
    "color": {
      "description": "The range of color for this beer style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfColor"
    },
    "carbonation": {
      "description": "Range of carbonation for this beer style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfCarbonation"
    },
    "alcohol_by_volume": {
      "description": "The range of alcohol by volume for this beer style.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfPercentageSimple"
    },
    "notes": {
      "description": "Description of the style, history",
      "type": "string"
    },
    "aroma": {
      "description": "Aroma profile for this style.",
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "flavor": {
      "description": "Flavor profile for this style.",
      "type": "string"
    },
    "mouthfeel": {
      "type": "string"
    },
    "overall_impression": {
      "type": "string"
    },
    "ingredients": {
      "description": "Suggested ingredients for this style",
      "type": "string"
    },
    "examples": {
      "description": "Example beers of this style.",
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "style_guide",
    "style_type"
  ],
  "unevaluatedProperties": false
}