{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.10.0/Style.beer.schema",
  "type": "object",
  "description": "A beer style may be from the BJCP style guide, Australian, UK or local style guides.  Generally a recipe is designed to one style.\n\nRange fields (`original_gravity`, `final_gravity`, `ibu`, `color`, `alcohol_by_volume`, `carbonation`) should be interpreted as typical range for the style, as given in the style guide (eg the “Vital Statistics” in the BJCP guidelines).  These are guidelines rather than hard limits: a beer slightly outside a range may still be a good example of the style.",
  "properties": {
    "name": {
      "description": "Name of the style profile – usually this is the specific name of the style – for example “Scottish Wee Heavy Ale” and not the Category which in this case might be “Scottish Ale”",
      "type": "string"
    },
    "category": {
      "description": "Category that this style belongs to – usually associated with a group of styles such as “English Ales” or “American Lagers”.",
      "type": "string"
    },
    "category_number": {
      "description": "Number or identifier associated with this style category. For example in the BJCP 2021 style guide, “Czech Premium Pale Lager” is category number “3”, style letter “B”, ie “3B”.\n\nNote that, despite the name, this needs to be a string rather than, say, an integer, because it can contain letters.  Eg BJCP mead and cider categories are M1–M4 and C1–C2.",
      "type": "string"
    },
    "style_letter": {
      // In contrast with BeerJSON, we do not allow the style letter to be a space.  If no style letter is set, this
      // field should simply be omitted.
      //
      // Also in contrast with BeerJSON, we allow more than one character, and digits as well as letters, because not
      // all style guides use a single letter for subcategories.  (BeerXML 2.01 described this field as "the specific
      // style number or subcategory letter".)
      //
      "description": "The specific subcategory letter (or a one- or two-digit sub-style number) associated with this particular style.  For example in the BJCP 2021 style guide, an American Lager would be style letter “B” under the main category (1 = Standard American Beer).  Letters should be upper case",
      "type": "string",
      "pattern": "^([A-Z]|[0-9]{1,2})$"
    },
    "style_guide": {
      "description": "Who published the guidelines, ideally with the edition, eg “BJCP 2021” or “BA 2024”.  Including the edition matters because category numbers and style definitions change between editions.",
      "type": "string"
    },
    "style_type": {
      "description": "Defines the type of beverage associated with this category.",
      "enum": [
        "beer",
        "cider",
        "kombucha",
        "mead",
        "other",
        "soda",
        "wine"
      ]
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this style.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Style object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "original_gravity": {
      "$ref": "Measurement.beer.schema#/$defs/RangeOfGravity"
    },
    "final_gravity": {
      "$ref": "Measurement.beer.schema#/$defs/RangeOfGravity"
    },
    //
    // Strictly speaking IBUs (international bitterness units) are not what is being measured by the units used to do
    // so.  However, IBU is the only widely-used unit, and it is common parlance amongst brewers to talk about the IBU
    // of a beer rather than bitterness.  (Eg the BJCP guidelines’ Vital Statistics list “IBUs” alongside OG, FG, SRM
    // and ABV.)  In any case, the "strictly-correct" name would not be "bitterness" or even "perceived_bitterness", as
    // what is actually measured is iso-alpha acid content.  And you almost never hear brewers saying "Would you say
    // that's within the iso-alpha acid content range for this style?" :)
    //
    "ibu": {
      "$ref": "Measurement.beer.schema#/$defs/RangeOfBitterness"
    },
    "color": {
      "$ref": "Measurement.beer.schema#/$defs/RangeOfColor"
    },
    "carbonation": {
      "description": "Note that, in contrast with the other range fields, the BJCP guidelines don’t give carbonation figures, so this usually comes from other sources.",
      "$ref": "Measurement.beer.schema#/$defs/RangeOfCarbonation"
    },
    "alcohol_by_volume": {
      "$ref": "Measurement.beer.schema#/$defs/RangeOfPercentageSimple"
    },
    "notes": {
      "description": "Anything else about the style not covered by the other fields, eg its history, or comments on what is and isn’t acceptable.  (In the BJCP guidelines, this is typically the “Comments” and “History” sections.)",
      "type": "string"
    },
    "aroma": {
      "description": "The aroma expected in a good example of the style: malt, hop, fermentation and other characteristics, and how they balance.",
      "type": "string"
    },
    "appearance": {
      "description": "Expected colour, clarity, and head (colour, texture and retention).",
      "type": "string"
    },
    "flavor": {
      "description": "Expected flavour profile: malt, hop bitterness and flavour, fermentation character, balance and finish.",
      "type": "string"
    },
    "mouthfeel": {
      "description": "Expected body, carbonation, alcohol warmth, creaminess, astringency and other sensations on the palate.",
      "type": "string"
    },
    "overall_impression": {
      "description": "A short summary of the style’s character, ie what distinguishes it at a glance.  Corresponds to the “Overall Impression” section of the BJCP guidelines.",
      "type": "string"
    },
    "ingredients": {
      "description": "The ingredients characteristic of the style, eg particular malts, hop varieties, yeast strains or water profile. Corresponds to “Characteristic Ingredients” in the BJCP guidelines.",
      "type": "string"
    },
    "examples": {
      "description": "Commercial beers that are good examples of the style.",
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "style_guide",
    "style_type"
  ],
  "unevaluatedProperties": false
}