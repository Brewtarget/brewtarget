{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  // I have oscillated between `Misc` and `MiscIngredient` for this.  The latter is "better" in terms of being more
  // descriptive, but both brevity and consistency with Brewtarget/Brewken push us towards the former.
  "$id": "https://dotbeer.org/schema/1.0.0/Misc.beer.schema",
  "type": "object",
  "description": "Miscellaneous ingredients that are not hops, fermentables, yeasts/cultures or water.  Some people would call these \"non-fermentable adjuncts\", but there are also narrower definitions of \"adjunct\", so we do not use that term.  Also often referred to as \"other ingredients\", but we already use \"other\" in a lot of classifications, so we prefer \"miscellaneous\" as abbreviated to \"misc\".",
  "properties": {
    "name": {
      "type": "string"
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this Misc object.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Misc object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "producer": {
      "description": "The company that produced the ingredient.",
      "type": "string"
    },
    "product_id": {
      "description": "Producer’s product code or number for this item.",
      "type": "string"
    },
    "misc_type": {
      "description": "If this is `water agent` then `water_agent_type` should also be set.",
      "enum": [
        "spice",
        "fining",
        "water agent",
        "herb",
        "flavor",
        "wood",
        "other"
      ]
    },
    // Not in BeerJSON (nor is water_agent_percent_acid)
    "water_agent_type": {
      "description": "Must be set if and only if `misc_type` is `water agent`.<br>`calcium chloride anhydrous` = CaCl₂<br>`calcium chloride dihydrate` = CaCl₂·2H₂O (Usual food-grade “flake”)<br>`calcium carbonate` = CaCO₃ (anhydrous; eg chalk)<br>`calcium sulfate dihydrate` = CaSO₄·2H₂O (gypsum)<br>`calcium hydroxide` = Ca(OH)₂ (pickling lime)<br>`magnesium sulfate heptahydrate` = MgSO₄·7H₂O  aka Epsom salt<br>`magnesium chloride hexahydrate` = MgCl₂·6H₂O<br>`sodium chloride` = NaCl  aka \"regular\" salt<br>`sodium bicarbonate` = NaHCO₃<br>`lactic acid` = CH₃CH(OH)CO₂H (extended formula) = C₃H₆O₃ (regular formula)<br>`phosphoric acid` = H₃PO₄<br>`sulfuric acid` = H₂SO₄<br>`hydrochloric acid` = HCl<br>`other` = none of the above",
      "enum": [
        "calcium chloride anhydrous",
        // Calcium chloride has multiple hydrates, but only this one is used in brewing
        "calcium chloride dihydrate",
        // Only the anhydrous form of calcium carbonate is used in brewing
        "calcium carbonate",
        // We deliberately omit anhydrous calcium sulfate as it is not typically used in brewing
        "calcium sulfate dihydrate",
        "calcium hydroxide",
        // We deliberately omit anhydrous magnesium sulfate as it is not typically used in brewing
        "magnesium sulfate heptahydrate",
        // There are 12 different hydrates of magnesium chloride, but this is the one typically used in brewing
        "magnesium chloride hexahydrate",
        "sodium chloride",
        "sodium bicarbonate",
        "lactic acid",
        "phosphoric acid",
        "sulfuric acid",
        "hydrochloric acid",
        "other"
        //
        // TBD: Consider in future adding:
        //
        //    citric acid : Citric acid (C₆H₈O₇) is a weak polyprotic organic acid, prominent in citrus fruits.  This
        //                  acid adds fruity or estery qualities, with a flavor threshold of around 150ppm in beer.  In
        //                  the past, citric acid was used for mash pH adjustment.  It has fallen out of favor for this
        //                  purpose because the flavor is detectable, especially since beer may already contain citric
        //                  acid, and so any addition may push the level over the flavor threshold.
        //
      ]
    },
    "water_agent_percent_acid": {
      "description": "The strength of an acid, as a percentage by weight, eg 88% for typical lactic acid or 10% for a typical phosphoric acid solution.  Acids are sold at widely varying strengths, so this should always be set for an acid, as otherwise an amount of it is ambiguous.\n\nShould only be set if `misc_type` is `water agent` and `water_agent_type` is an acid (`lactic acid`, `phosphoric acid`, `sulfuric acid` or `hydrochloric acid`) or `other`.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "use_for": {
      "description": "Used to describe the purpose of the miscellaneous ingredient, e.g. whirlfloc is used for clarity.",
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
    // BeerJSON and BeerXML have `inventory` here, but we prefer to keep inventory separate and more detailed via
    // StockPurchaseMisc and StockUseMisc
  },
  "required": [
    "name",
    "misc_type"
  ],
  //
  // See https://json-schema.org/understanding-json-schema/reference/conditionals#dependentSchemas for how the
  // "dependentSchemas" keyword works.  Essentially, it allows us to enforce that `water_agent_type` and
  // `water_agent_percent_acid` only be set if `misc_type` is `water agent`, and additionally that
  // `water_agent_percent_acid` only be set if `water_agent_type` is an acid (or `other`).
  //
  "dependentSchemas": {
    "water_agent_type"        : {
      "properties": { "misc_type": { "const": "water agent" } }
    },
    "water_agent_percent_acid": {
      "properties": {
        "misc_type":        { "const": "water agent" },
        "water_agent_type": { "enum": ["lactic acid", "phosphoric acid", "sulfuric acid", "hydrochloric acid", "other"] }
      },
      //
      // As with if/then, `properties` only checks keys that are present, so we need `required` here to stop
      // `water_agent_percent_acid` being accepted when `water_agent_type` is absent.
      //
      "required": ["water_agent_type"]
    }
  },
  //
  // For `water_agent_type`, we have a stronger requirement, that it _must_ be set if `misc_type` is "water agent".
  // This if/then enforces that.
  //
  "if": {
    //
    // Strictly, we don't need "required" here as `misc_type` is already required above.  However, it's idiomatic to use
    // it, as `properties` only checks keys that are present.
    //
    "properties": { "misc_type": { "const": "water agent" } },
    "required": ["misc_type"]
  },
  "then": {
    "required": ["water_agent_type"]
  },
  "unevaluatedProperties": false,
  "$defs": {
    "MiscAmount" : {
      "description": "The ways in which an amount of a Misc could be measured",
      "oneOf": [
        {
          "$ref": "Measurement.beer.schema#/$defs/Volume"
        },
        {
          "$ref": "Measurement.beer.schema#/$defs/Mass"
        },
        {
          "$ref": "Measurement.beer.schema#/$defs/Count"
        }
      ]
    }
  }
}