{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.10.0/Recipe.beer.schema",
  "type": "object",
  "description": "The information stored in a beer recipe.",
  "properties": {
    "name": {
      "type": "string"
    },
    // NB: Recipes do not have a local ID, as there is currently nothing that cross-refers to a recipe
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Recipe object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "recipe_type": {
      "enum": [
        "cider",
        "kombucha",
        "soda",
        "other",
        "mead",
        "wine",
        "extract",
        "partial mash",
        "all grain"
      ]
    },
    "author": {
      "type": "string"
    },
    "coauthor": {
      "type": "string"
    },
    "created": {
      //
      // At the moment, in Brewtarget/Brewken, we only store this as a date, but it's conceivable we might want to
      // allow it to include a timestamp in future.
      //
      "$ref": "Measurement.beer.schema#/$defs/DateOrDateTimeLocal"
    },
    "batch_size": {
      "description": "The volume into the fermentation vessel.",
      "$ref": "Measurement.beer.schema#/$defs/Volume"
    },
    "efficiency": {
      "type": "object",
      "description": "Stores each efficiency component.",
      "properties": {
        // BeerJSON has additional efficiencies for "conversion", "lauter" and "mash", but we don't support these in
        // Brewken or Brewtarget.
        "brewhouse": {
          "description": "The percentage of the available sugar that makes it from the fermentables into the fermenter.  This only applies to fermentables whose sugars have to be extracted (eg grain that is mashed or steeped).  The sugar in extracts and sugars is assumed to be fully available.  So, in an extract recipe with no grain, this value has no effect.",
          "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
        }
      },
      "required": [
        "brewhouse"
      ],
      "unevaluatedProperties": false
    },
    "style_id": {
      "description": "Local ID of the style of this recipe.  (Obviously the style in question must be in the \"styles\" section of the same dotBeer file.)",
      "x-refers-to": "/DotBeer/styles",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "equipment_id": {
      "description": "Local ID of the equipment for this recipe.  (Obviously the equipment in question must be in the \"equipments\" section of the same dotBeer file.)",
      "x-refers-to": "/DotBeer/equipments",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "ingredients": {
      "type": "object",
      "description": "All the recipe's ingredient additions.  Note that these lists are cross-references (via \"local IDs\") to ingredient definitions that must appear in the same file.  This saves on repetition when, eg, the same type of hop is added at more than one point.  If you are exporting one or more recipes, you must also export the full versions of their ingredients in the same file.",
      "properties": {
        "fermentable_additions": {
          "type": "array",
          "description": "All the fermentable additions to the recipe",
          "items": {
            "$ref": "#/$defs/FermentableRecipeAddition"
          }
        },
        "hop_additions": {
          "type": "array",
          "description": "All the hop additions to the recipe",
          "items": {
            "$ref": "#/$defs/HopRecipeAddition"
          }
        },
        "misc_additions": {
          "type": "array",
          "description": "All the miscellaneous item additions to the recipe",
          "items": {
            "$ref": "#/$defs/MiscRecipeAddition"
          }
        },
        "culture_additions": {
          "type": "array",
          "description": "All the yeast and/or other culture additions to the recipe",
          "items": {
            "$ref": "#/$defs/CultureRecipeAddition"
          }
        }
        //
        // Note, per comments in Water.beer.schema that water is treated differently from other ingredients, and a
        // recipe does not have water_additions.  Instead, the _amounts_ of water needed are defined in the mash, and
        // the _types_ of water are in water_profile_base and water_profile_target
        //
      },
      "required": [
        "fermentable_additions"
      ],
      "unevaluatedProperties": false
    },
    "water_base_id": {
      "description": "Optional parameter to specify the Local ID of the starting profile of the brewing water, which may be modified with salts etc to obtain the target profile.",
      "x-refers-to": "/DotBeer/waters",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "water_target_id": {
      "description": "Optional parameter to specify the Local ID of the desired profile of the brewing water, which may be modified with salts etc from the base (starting) profile.",
      "x-refers-to": "/DotBeer/waters",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "ro_water_mash": {
      "description": "Percentage of the mash water that is reverse-osmosis (rather than the same profile as `water_base_id`).  If this field is not present, a value of 0.0 may be assumed.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "ro_water_sparge": {
      "description": "Percentage of the sparge water that is reverse-osmosis (rather than the same profile as `water_base_id`).  If this field is not present, a value of 0.0 may be assumed.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "mash_id": {
      "description": "Local ID of the mash procedure used in this recipe.  (Obviously the mash in question must be in the \"mashes\" section of the same dotBeer file.)",
      "x-refers-to": "/DotBeer/mashes",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "boil_id": {
      "description": "Local ID of the boil procedure used in this recipe.  (Obviously the boil in question must be in the \"boils\" section of the same dotBeer file.)",
      "x-refers-to": "/DotBeer/boils",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "fermentation_id": {
      "description": "Local ID of the fermentation procedure used in this recipe.  (Obviously the fermentation in question must be in the \"fermentations\" section of the same dotBeer file.)",
      "x-refers-to": "/DotBeer/fermentations",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    //
    // If and when we support packaging, we'll add it here
    //
    "notes": {
      "type": "string"
    },
    "original_gravity": {
      "description": "The expected gravity of wort when transferred to the fermenter.  Typically this and `final_gravity` are calculated values, so they are written out for information but ignored (or overwritten by a calculated value) for recipes read in from a file.",
      "$ref": "Measurement.beer.schema#/$defs/Gravity"
    },
    "final_gravity": {
      "description": "The expected gravity of beer at the end of fermentation.  Comments about `original_gravity` apply equally here.",
      "$ref": "Measurement.beer.schema#/$defs/Gravity"
    },
    "alcohol_by_volume": {
      "description": "The expected alcohol by volume of the finished beer, typically calculated from `original_gravity` and `final_gravity`.  Comments about `original_gravity` apply equally here.  (Measured values for an actual brew of the recipe go in its brew log.)",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "ibu_estimate": {
      "description": "Estimated bitterness of finished beer.",
      "$ref": "Measurement.beer.schema#/$defs/Bitterness"
    },
    "ibu_estimate_formula": {
      "description": "Used to differentiate which IBU formula is being used in a recipe.",
      "enum": [
        "Tinseth",
        "Rager",
        "Noonan",
        "mIBU",
        "Garetz",
        "SMPH",
        "Daniel",
        "other"
      ]
    },
    "color_estimate": {
      "description": "The color of the finished beer, using SRM or EBC.",
      "$ref": "Measurement.beer.schema#/$defs/Color"
    },
    "beer_pH": {
      "description": "The final beer pH at the end of fermentation.",
      "$ref": "Measurement.beer.schema#/$defs/Acidity"
    },
    "carbonation": {
      "description": "The final carbonation of the beer when packaged or served.",
      "$ref": "Measurement.beer.schema#/$defs/Carbonation"
    },
    "apparent_attenuation": {
      "description": "The total apparent attenuation of the finished beer after fermentation.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "taste": {
      "type": "object",
      "description": "Subjective tasting notes, and rating.",
      "properties": {
        "notes": {
          "type": "string"
        },
        "rating": {
          //
          // The 0-50 range follows BeerXML.  In BeerJSON, there is no constraint, but I don't know whether that is
          // oversight or deliberate.
          //
          // The BJCP Beer Scoresheet divides the evaluation into five major areas, each scored on whole points:
          //    - Aroma: 12 points
          //    - Appearance: 3 points
          //    - Flavor: 20 points
          //    - Mouthfeel: 5 points
          //    - Overall Impression: 10 points
          // That adds up to a maximum possible score of 50 points.
          //
          // The scoresheet breaks the results into these general ranges:
          //    - Outstanding: 45 to 50 – World-class example of style
          //    - Excellent: 38 to 44 – Exemplifies style well and requires only minor fine-tuning
          //    - Very Good: 30 to 37 – Generally within style parameters with some minor flaws
          //    - Good: 21 to 29 – Misses the mark on style and/or has minor flaws
          //    - Fair: 14 to 20 – Off flavors, aromas or major style deficiencies
          //    - Problematic: 0 to 13 – Major off flavors and aromas dominate
          //
          // NB: The type here is deliberately `number` not `integer`.  Although an individual BJCP judge’s score is a
          //     whole number, the score a brewer actually gets back is not necessarily an integer as some competitions
          //     report the average of two or three judges’ scores.  Equally, a brewer who tastes a batch several times
          //     might also want to record an average.
          //
          "description": "Number between zero and 50 denoting the taste rating – corresponds to the 50 point BJCP rating system.",
          "type": "number",
          "minimum":  0.0,
          "maximum": 50.0
        }
      },
      "required": [
        "notes",
        "rating"
      ],
      "unevaluatedProperties": false
    },
    "energy_content": {
      // TBD: There is, in principle at least, more than one way to do this estimate.  But I don't know in practice
      //      how many different approaches are used.
      "description": "Estimate of the energy content of this beer (as used on nutritional labelling).  Typically calculated.",
      "$ref": "Measurement.beer.schema#/$defs/EnergyPerVolume"
    },
    "instructions": {
      "type": "array",
      "description": "Records of individual instructions for this recipe",
      "items": {
        "$ref": "#/$defs/Instruction"
      }
    },
    "brew_logs": {
      "type": "array",
      "description": "Records of individual brews of this recipe",
      "items": {
        "$ref": "#/$defs/BrewLog"
      }
    }
  },
  "required": [
    "name",
    "recipe_type",
    "author",
    "efficiency",
    "batch_size",
    "ingredients"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "AdditionSchedule": {
      "type": "object",
      "description": "This object fully describes when, and for how long, a recipe addition should be made, with options for basis on time, gravity, or pH at any process step.\n\nHop additions that BeerXML would call *first wort* and *aroma* (eg whirlpool, hop stand or flameout additions) are expressed through the step of the boil in which they are made.  By convention, a boil has a pre-boil step (ramping up from mash temperature), then the boil proper, then one or more post-boil steps (cooling).\n\nA boil step is part of the *boil proper* if its start and end temperatures are both above 81°C (178°F).  (This is above any mash-out temperature and below the boiling point of water at any inhabited altitude.)  A boil step whose start or end temperature is not given is assumed to be at boiling at that point.  The length of the boil proper is the total `step_time` of its steps.  So:<br> • a first wort addition is `add_to_boil` in a first step (typically `step` 1) that starts at or below 81°C<br> • an ordinary boil addition is `add_to_boil` in the boil proper (typically `step` 2, or with `step` not set), with `time` being how long before the end of the boil proper it is added<br> • a whirlpool or hop stand addition is `add_to_boil` in a later step (typically `step` 3) that ends at or below 81°C, with `duration` being how long the hops steep<br>Readers should identify these steps by their temperatures, as above, rather than relying on the step numbers.",
      "properties": {
        "time": {
          "description": "What time during a process step is added, eg a value of 2 days for a dry hop addition would be added 2 days into the fermentation step.  NOTE that, when `stage` is `add_to_boil`, this is time *before* the *end* of the step (or, if no step is specified, of the boil proper -- ie excluding any post-boil steps, as explained above).  For other values of `stage`, this is time *after* the *start* of the step (or of the process if no step is specified).  If none of `time`, `specific_gravity` and `pH` is set, the addition is made at the start of the step (or of the process if no step is specified).",
          //
          // We have chosen to follow BeerJSON here rather than reinvent the wheel, not least because it keeps things
          // simpler in Brewtarget and Brewken.  An alternative approach would have been to have positive values
          // represent "time after start of the step" and negative ones represent "time before end of step", probably
          // necessitating [unset] meaning "at the start of the step" and 0.0 meaning "at the end".  This would arguably
          // be cleaner if we were starting from scratch, but it doesn't otherwise buy us anything.
          //
          "$ref": "Measurement.beer.schema#/$defs/Time"
        },
        "duration": {
          "description": "How long an ingredient addition remains, this was referred to as time in the BeerXML standard. Eg A 40 minute hop boil additions means to boil for 40 minutes, and a 2 day duration for a dry hop means to remove it after 2 days.  If this field is not set or not present, the addition is generally assumed to be removed at the end of the `stage` in which it was added.  For a whirlpool or hop stand addition (see above), this is the steeping time.  (Thus, this field is normally only needed if an addition is to be removed before the end of the `stage` it was added.)",
          "$ref": "Measurement.beer.schema#/$defs/Time"
        },
        // BeerJSON has "continuous" here, but we don't support this in Brewken or Brewtarget
        "specific_gravity": {
          "description": "Used (as an alternative to `time`) to indicate when an addition is added based on a desired specific gravity.  Eg Add dry hop at when SG is 1.018.",
          "$ref": "Measurement.beer.schema#/$defs/Gravity"
        },
        "pH": {
          "description": "Used (as an alternative to `time`) to indicate when an addition is added based on a desired specific pH.  Eg Add brett when pH is 3.4.",
          "$ref": "Measurement.beer.schema#/$defs/Acidity"
        },
        "step": {
          // We don't currently model steps for packaging, so this field isn't meaningful if stage=add_to_package.  But
          // it could be that this will change in future.
          "description": "Used to indicate what step this ingredient timing addition is referencing.  Steps are numbered from 1.  Eg A value of 2 for add_to_fermentation would mean to add during the second fermentation step.",
          "type": "integer",
          "minimum" : 1
        },
        "stage": {
          // In BeerJSON, this is called "use", but I think that's for historical reasons -- eg that it replaces the
          // USE field on HOP in BeerXML.  Anyway, "stage" is somewhat clearer IMHO.
          "description": "Differentiates the specific process type when this ingredient addition is used.  Note that `add_to_package` is used, for example, for priming sugar added when beer is bottled.",
          "enum": [
            "add_to_mash",
            "add_to_boil",
            "add_to_fermentation",
            "add_to_package"
          ]
        }
      },
      "required": [
        "stage"
      ],
      //
      // `time`, `specific_gravity` and `pH` are alternative ways of saying when the addition is made, so at most one of
      // them may be set.  (It's fine to set none of them -- eg to add something at the start of a step.)  We express
      // this as "not (any two of them are present)".
      //
      "not": {
        "anyOf": [
          { "required": ["time"            , "specific_gravity"] },
          { "required": ["time"            , "pH"              ] },
          { "required": ["specific_gravity", "pH"              ] }
        ]
      },
      "unevaluatedProperties": false
    },
    "CultureRecipeAddition": {
      "type": "object",
      "description": "Collects the attributes of each culture ingredient for use in a recipe.  (Unlike in BeerJSON, the `schedule` element is required, as it is for other additions.  For a culture pitched at the start of fermentation, it need only contain `\"stage\": \"add_to_fermentation\"`.)",
      "properties": {
        "culture_id": {
          "description": "The Local ID of the culture in this addition.  (Obviously the culture in question must be in the \"cultures\" section of the same dotBeer file.)",
          "x-refers-to": "/DotBeer/cultures",
          "$ref": "DotBeer.beer.schema#/$defs/LocalId"
        },
        "attenuation": {
          "description": "The expected, or measured apparent attenuation for a given culture in a given recipe.  In comparison to attenuation range, this is a single value.",
          "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
        },
        "times_cultured": {
          "description": "How many times this culture has been harvested and reused; 0 for fresh product from the producer.",
          "type": "integer",
          "minimum": 0
        },
        "schedule": {
          "$ref": "#/$defs/AdditionSchedule"
        },
        "cell_count_billions": {
          // TODO: We don't yet support this in Brewtarget/Brewken!
          "type": "number",
          "minimum": 0
        },
        "amount": {
          "$ref": "Culture.beer.schema#/$defs/CultureAmount"
        }
      },
      "required": [
        "culture_id",
        // In BeerJSON, schedule is optional for cultures, but we always write it out in Brewken/Brewtarget, even if it
        // only contains `"stage": "add_to_fermentation"`, so it's more consistent to require it in dotBeer.
        "schedule",
        "amount"
      ],
      "unevaluatedProperties": false
    },
    "FermentableRecipeAddition": {
      "type": "object",
      "description": "Collects the attributes of each fermentable ingredient for use in a recipe fermentable bill.",
      "properties": {
        "fermentable_id": {
          "description": "The Local ID of the fermentable in this addition.  (Obviously the fermentable in question must be in the \"fermentables\" section of the same dotBeer file.)",
          "x-refers-to": "/DotBeer/fermentables",
          "$ref": "DotBeer.beer.schema#/$defs/LocalId"
        },
        "schedule": {
          "$ref": "#/$defs/AdditionSchedule"
        },
        "amount": {
          "$ref": "Fermentable.beer.schema#/$defs/FermentableAmount"
        }
      },
      "required": [
        "fermentable_id",
        "schedule",
        "amount"
      ],
      "unevaluatedProperties": false
    },
    "HopRecipeAddition": {
      "type": "object",
      "description": "Collects the attributes of each hop ingredient for use in a recipe hop bill.",
      "properties": {
        "hop_id": {
          "description": "The Local ID of the hop in this addition.  (Obviously the hop in question must be in the \"hops\" section of the same dotBeer file.)",
          "x-refers-to": "/DotBeer/hops",
          "$ref": "DotBeer.beer.schema#/$defs/LocalId"
        },
        "schedule": {
          "$ref": "#/$defs/AdditionSchedule"
        },
        "amount": {
          "$ref": "Hop.beer.schema#/$defs/HopAmount"
        }
      },
      "required": [
        "hop_id",
        "schedule",
        "amount"
      ],
      "unevaluatedProperties": false
    },
    "MiscRecipeAddition": {
      "type": "object",
      "description": "Collects the attributes of each miscellaneous ingredient for use in a recipe.",
      "properties": {
        "misc_id": {
          "description": "The Local ID of the misc in this addition.  (Obviously the misc in question must be in the \"miscs\" section of the same dotBeer file.)",
          "x-refers-to": "/DotBeer/miscs",
          "$ref": "DotBeer.beer.schema#/$defs/LocalId"
        },
        "schedule": {
          "$ref": "#/$defs/AdditionSchedule"
        },
        "amount": {
          "$ref": "Misc.beer.schema#/$defs/MiscAmount"
        }
      },
      "required": [
        "misc_id",
        "schedule",
        "amount"
      ],
      "unevaluatedProperties": false
    },
    "Instruction": {
      "type": "object",
      "description": "Descriptive instruction for what to do at a particular point in a recipe.",
      "properties": {
        "name": {
          "description": "This is the title of the instruction, eg \"Step 2: Heat water\".",
          "type": "string"
        },
        "directions": {
          "description": "Detail of what to do at this step, eg \"Bring 11.5 L of water to 68.0°C for upcoming infusions\".",
          "type": "string"
        },
        "duration": {
          "description": "Where the instruction involves adding something to the boil or holding the mash at a particular temperature, this field tells you how long that should be for.  Eg, if the instruction is \"Add 11.5 L water at 68.0 °C to mash to bring it to 68.0 °C. Hold for 50 min.\" then this field would be `{\"unit\":\"min\",\"value\":50}`.",
          "$ref": "Measurement.beer.schema#/$defs/Time"
        }
      },
      "required": [
        "name",
        "directions"
      ],
      "unevaluatedProperties": false
    },
    "BrewLog": {
      "type": "object",
      "description": "Record of a \"brewday\", ie of an individual brew of a recipe.  Note that:<br> • Fields beginning with \"expected_\" are values taken from the Recipe (either directly or by calculation)<br> • Fields beginning with \"measured_\" are supplied by the brewer for this batch -- eg measured OG and FG<br> • Fields beginning with \"computed_\" are derived from values supplied by the brewer -- eg ABV calculated from measured OG and FG<br>Strictly speaking, \"expected_\" and \"computed_\" fields are not needed because they can be derived from other information.  However, we include them because (a) a recipe might have been modified after a brewday and (b) some calculations (eg alcohol by volume) might be done differently by different programs.",
      "properties": {
        "local_id" : {
          "description": "The \"local ID\" that allows other objects in this file (eg stock use instances) to refer to this brew log.",
          "$ref": "DotBeer.beer.schema#/$defs/LocalId"
        },
        "batch_number": {
          "description": "The brewer's own unique identifier for this brew.  It can contain numbers and/or letters and/or symbols, so, \"number\" might seem a bit of a misnomer; nonetheless, it is the standard term for such an identifying code.",
          "type": "string"
        },
        "brew_date": {
          "description": "The date of the \"brewday\"",
          // Don't see any need to include time here
          "$ref": "Measurement.beer.schema#/$defs/Date"
        },
        "ferment_date": {
          "description": "The date fermentation was deemed finished and final gravity readings were taken",
          // Don't see any need to include time here
          "$ref": "Measurement.beer.schema#/$defs/Date"
        },
        "notes": {
          "type": "string"
        },
        "expected_pre_boil_gravity": {
          "description": "Expected (planned) pre-boil specific gravity",
          "$ref": "Measurement.beer.schema#/$defs/Gravity"
        },
        "measured_pre_boil_gravity": {
          "description": "Actual (measured) pre-boil specific gravity",
          "$ref": "Measurement.beer.schema#/$defs/Gravity"
        },
        "expected_pre_boil_volume": {
          "description" : "Expected (planned) volume of wort to be collected from mash into boil kettle",
          "$ref": "Measurement.beer.schema#/$defs/Volume"
        },
        "measured_pre_boil_volume": {
          "description" : "Actual (measured) volume of wort collected from mash into boil kettle",
          "$ref": "Measurement.beer.schema#/$defs/Volume"
        },
        "expected_strike_temperature": {
          "description" : "Expected (planned) strike water temperature (ie water temperature immediately prior to adding grains at mash start)",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
        "measured_strike_temperature": {
          "description" : "Actual (measured) strike water temperature (ie water temperature immediately prior to adding grains at mash start)",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
        "expected_mash_final_temperature" : {
          "description": "Expected (planned) final mash temperature (before any mash out)",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
        "measured_mash_final_temperature" : {
          "description": "Actual (measured) final mash temperature (before any mash out)",
          "$ref": "Measurement.beer.schema#/$defs/Temperature"
        },
