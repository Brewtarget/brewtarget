{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.10.0/Mash.beer.schema",
  "type": "object",
  "description": "A mash procedure, which can be used by multiple recipes.",
  "properties": {
    "name": {
      "type": "string"
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this mash.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Mash object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "grain_temperature": {
      "description": "Initial grain temperature prior to the start of the mash.",
      "$ref": "Measurement.beer.schema#/$defs/Temperature"
    },
    "notes": {
      "type": "string"
    },
    "mash_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/MashStep"
      }
    }
  },
  "required": [
    "name",
    "grain_temperature",
    "mash_steps"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "MashStep": {
      "type": "object",
      "description": "A mash step is an internal record used within a mash profile to denote a separate step in a multi-step mash.  A mash step is not intended for use outside of a mash profile.",
      "allOf": [
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepBase"
        },
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepWithRampTime"
        },
        {
          "properties": {
            "step_type": {
              "description": "`infusion` = raise or set the mash temperature by adding hot water (`amount` is the volume added, and `infuse_temperature` its temperature)<br>`temperature` = raise or hold the mash temperature by applying heat directly (eg a heated or recirculating mash tun), without adding water<br>`decoction` = raise the mash temperature by drawing off part of the mash, boiling it and returning it (`amount` is the volume drawn off)<br>`souring mash` = hold the mash, grain included, warm with lactic acid bacteria (whether added or naturally present on the grain) to sour it before lautering (aka sour mashing)<br>`souring wort` = hold the separated wort, without grain, warm with lactic acid bacteria to sour it before the boil (aka kettle souring)<br>`drain mash tun` = run the wort off from the mash tun into the kettle, eg collecting the first runnings, or between batch sparges<br>`sparge` = rinse the grain bed with hot water to extract remaining sugars, either continuously (fly sparge) or in batches (batch sparge)",
              "enum": [
                "infusion",
                "temperature",
                "decoction",
                "souring mash",
                "souring wort",
                "drain mash tun",
                "sparge"
              ]
            },
            "amount": {
              "description": "For an `infusion` step, this is the volume of water to infuse in this step.  For a `decoction` step, this is the calculated volume of mash drawn off to be boiled and returned to the main mash (typically calculated from the target temperature rise).  For a `sparge` step, this is the volume of water added.\n\nThis field is normally only meaningful when `step_type` is `infusion`, `decoction` or `sparge`.",
              "$ref": "Measurement.beer.schema#/$defs/Volume"
            },
            "water_grain_ratio": {
              "description": "Also known as the mash thickness, this is total ratio of water to grain (eg 1.75 qt/lb or 3.65 L/kg) for this step AFTER the infusion.  Note this value must be consistent with the required infusion amount and amounts added in earlier steps.\n\nThis field is normally only meaningful when `step_type` is `infusion`.",
              "$ref": "Measurement.beer.schema#/$defs/VolumePerMass"
            },
            "infuse_temperature": {
              "description": "Temperature of the water for an infusion step -- typically calculated based on the current step, grain, and other settings.\n\nThis field is normally only meaningful when `step_type` is `infusion`.",
              "$ref": "Measurement.beer.schema#/$defs/Temperature"
            }
          }
        }
      ],
      "required": [
        "name",
        "step_type",
        "start_temperature",
        "step_time"
      ],
      "unevaluatedProperties": false
    }
  }
}