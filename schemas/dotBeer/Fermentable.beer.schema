{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.10.0/Fermentable.beer.schema",
  "type": "object",
  "description": "An ingredient that contributes extractable sugar (and usually colour): malts and other grains, extracts, sugars, honey, fruit, juice.\n\nAs noted in descriptions, some fields are only meaningful for certain types of fermentable.  On the whole, the schema does not try to enforce this, partly in the interests of simplicity and partly because analysis sheets for unusual products do sometimes quote these values.",
  "properties": {
    "name": {
      "type": "string"
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this fermentable.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Fermentable object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "fermentable_type": {
      "enum": [
        "dry extract",
        "extract",
        "grain",
        "sugar",
        "fruit",
        "juice",
        "honey",
        "other"
      ]
    },
    "origin": {
      "description": "Country or place of origin",
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "product_id": {
      "description": "Producer’s product code or number for this item.",
      "type": "string"
    },
    "grain_group": {
      "description": "This should only be set when `fermentable_type` is `grain`.",
      "type": "string",
      "enum": [
        "base",
        "caramel",
        "flaked",
        "roasted",
        "specialty",
        "smoked",
        "adjunct"
      ]
    },
    "yield_fine_grind": {
      "description": "Extract Yield Dry Basis Fine Grind (DBFG) - aka percentage yield, compared to sucrose, of a fine grind, or, for extracts and sugars, the raw yield by weight.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "yield_coarse_grind": {
      "description": "Extract Yield Dry Basis Coarse Grind (DBCG) - aka percentage yield, compared to sucrose, of a coarse grind.\n\nThis field is normally only meaningful when `fermentable_type` is `grain`.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "yield_fine_coarse_difference": {
      "description": "Extract Fine Grind/Coarse Grind Difference (FG/CG) - aka the difference in yield between coarsely milled and finely milled grain.  A FG/CG difference of 0.5–1.0 percentage points is well suited to a single step infusion, while a value greater than 1.5 percentage points indicates that a protein rest or step mash may be advisable.\nNote that `yield_fine_coarse_difference` should be the same as `yield_fine_grind` minus `yield_coarse_grind`.\n\nThis field is normally only meaningful when `fermentable_type` is `grain`.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "yield_potential": {
      "description": "The \"potential yield\", which is the gravity of a solution containing 1 lb of this ingredient per US gallon (≈ 119.8 g/L), assuming all its extract dissolves, for the ingredient as weighed (ie including any moisture).  Brewers often quote this as “points per pound per gallon” (PPG), ie (SG − 1) × 1000; eg 1.037 SG = 37 PPG.\n\nWhere this is not known, it can be estimated, as specific gravity, from 1 + 0.046 × yield_fine_grind / 100 × (1 − moisture / 100), where 1.046 is the value for sucrose.",
      "$ref": "Measurement.beer.schema#/$defs/Gravity"
    },
    "color": {
      "description": "Maltsters typically measure grain color in degrees Lovibond, but other units are supported here.",
      "$ref": "Measurement.beer.schema#/$defs/Color"
    },
    "notes": {
      "type": "string"
    },
    "moisture": {
      "description": "Percentage moisture.  Note that this is not just used for grains: moisture matters at least as much for LME (~20%), honey (~17–18%) and DME (~2–4%).",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "alpha_amylase": {
      "description": "Total amount of alpha-amylase in the malted grain, measured in dextrinizing units.  (Since you ask, one α-amylase dextrinizing unit is defined as the quantity of α-amylase that will dextrinize soluble starch in the presence of an excess of β-amylase at the rate of 1 g/h at 30°C.  Or, at least, that's what it says at https://www.deerland.com/wp-content/uploads/2015/04/EnzymeAssayUnits_Deerland.pdf.)  Anyway, a value of 25-50 is desirable for base malt.\n\nThis field is normally only meaningful for *malted* grains.",
      "type": "number",
      "minimum": 0
    },
    "diastatic_power": {
      "description": "Behind malt extract, diastatic power is usually considered the second most important malt quality measurement.  A value of 35 Lintner is needed to self convert, while a value of 100 or more is desirable for base malts.\n\nThis field is *normally* only meaningful for *malted* grains (though note that a few diastatic malt extracts do exist).",
      "$ref": "Measurement.beer.schema#/$defs/DiastaticPower"
    },
    "protein": {
      "description": "The percentage of protein.  Higher values may indicate a possibility of haze, or lautering issues.\n\nThis field is normally only meaningful for malts (ie malted grains) and malt extracts.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "kolbach_index": {
      "description": "The Kolbach Index, also known as soluble to total ratio of nitrogen or protein, is used to indicate the degree of malt modification. A value above 35% is desired for simple single infusion mashing, undermodified malt may require multiple step mashes or decoction.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "max_in_batch": {
      "description": "The recommended maximum percentage, by weight, of this ingredient in the total fermentables of a recipe.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "recommend_mash": {
      "description": "True if it is recommended that the fermentable be mashed, false if it can be steeped.  This is a property of the ingredient, used when designing recipes: it does not say whether the fermentable is actually mashed in any particular recipe.\n\nThis field is normally only meaningful when `fermentable_type` is `grain`.",
      "type": "boolean"
    },
    // BeerJSON and BeerXML have `inventory` here, but we prefer to keep inventory separate and more detailed via
    // StockPurchaseFermentable and StockUseFermentable
    "hardness_prp_glassy": {
      "description": "Percentage of malt that is \"glassy\".  For a malt, % \"glassy\" + % \"half glassy\" + % \"mealy\" = 100%.\n\nMaltsters classify kernels by how much of the endosperm is hard and glassy (vitreous) rather than soft and mealy: mealy kernels are up to 25% glassy, half-glassy 26–75%, and glassy more than 75%.  Glassy kernels are generally a sign of poor modification, and mill and mash less well.  As a rule of thumb, a base malt should be at least 90% mealy, and at least 95% mealy for a single-infusion mash.  (See https://byo.com/article/understanding-malt-spec-sheets-advanced-brewing/ and https://www.probrewer.com/library/malt/understanding-malt-analysis-sheets/.)\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "hardness_prp_half": {
      "description": "Percentage of malt that is \"half glassy\".  For a malt, % \"glassy\" + % \"half glassy\" + % \"mealy\" = 100%.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "hardness_prp_mealy": {
      "description": "Percentage of malt that is \"mealy\".  For a malt, % \"glassy\" + % \"half glassy\" + % \"mealy\" = 100%.\n\nSome analyses instead give a single \"vitreosity\" figure: the average over all kernels, where glassy counts as 1, half-glassy as 0.5 and mealy as 0.  A vitreosity of 0.25 or below is generally considered good.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "kernel_size_prp_plump": {
      "description": "Percentage of grain that is \"plump\", ie retained by a sieve of a given size: typically 6/64 inch (2.38 mm) or 7/64 inch (2.78 mm) in the US, or 2.5 mm in Europe.  80% or more is generally desirable.\n\nLarger kernels generally give more extract, while small ones may indicate poor modification.  A uniform kernel size also matters, as a malt with a mix of sizes will not mill evenly.  (See https://byo.com/article/understanding-malt-spec-sheets-advanced-brewing/ and https://www.probrewer.com/library/malt/understanding-malt-analysis-sheets/.)\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "kernel_size_prp_thin": {
      "description": "Percentage of grain that is \"thin\", ie that passes through a sieve of typically 5/64 inch (1.98 mm) in the US, or 2.2 mm in Europe.  Lower is better: more than 2–3% suggests poorly modified kernels and is likely to cause milling problems.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "friability": {
      "description": "Friability is the measure of a malt's ability to crumble during the crush, and is used as an indicator for easy gelatinization of the grain and starches, as well as modification of the malt. Value of 85% or higher indicates a well modified malt and is suitable for single step mashes. Lower values may require a step mash.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "di_pH": {
      "description": "The pH of wort made by mashing the malt alone in distilled (or deionised) water, which is where the \"DI\" comes from.  This is a key input for mash pH prediction and water chemistry calculations.  DI pH varies by malt type, and between maltsters for nominally the same malt.\n\nOne way to measure it is to mash 40 g of finely crushed grain in 100 mL of distilled water at 52°C (125°F) for 20 minutes, then measure the pH once the wort has cooled to 25°C (77°F).  (See https://www.thescrewybrewer.com/2016/12/the-influence-of-grain-di-ph-on-mash-ph.html.)\n\nThis field is normally only meaningful when `fermentable_type` is `grain`.",
      "$ref": "Measurement.beer.schema#/$defs/Acidity"
    },
    "viscosity": {
      "description": "The measure of wort viscosity, typically associated with the breakdown of beta-glucans. The higher the viscosity, the greater the need for a glucan rest and the less suitable for a fly sparge.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/Viscosity"
    },
    "dms_p": {
      "description": "The amount (per unit mass of malt, as given on a malt analysis sheet, eg ppm = mg/kg) of DMS precursors, namely S-methyl methionine (SMM) and dimethyl sulfoxide (DMSO) in the malt which convert to dimethyl sulfide (DMS).\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/MassFractionOrConcentration"
    },
    "fan": {
      "description": "Free Amino Nitrogen (FAN): the amino acids and small peptides available to yeast as a nitrogen source. As given on a malt analysis sheet, ie measured in a Congress (standard laboratory) wort, typically in mg/L. A well-modified base malt is typically around 150–180 mg/L. Note that the FAN of your actual wort will differ, depending on its gravity and the rest of the grain bill.\n\nThis field is normally only meaningful for malts (ie malted grains) and malt extracts.",
      "$ref": "Measurement.beer.schema#/$defs/MassFractionOrConcentration"
    },
    "fermentability": {
      "description": "Fermentability - indicates a baseline typical apparent attenuation for a typical medium attenuation yeast.\n\nThis field is normally only meaningful for extracts (and possibly sugars and honey).  Compare `fermentable_fraction`.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "fermentable_fraction": {
      "description": "The percentage of this ingredient's extract that brewing yeast (*Saccharomyces*) can ferment.  The rest is treated as unfermentable when estimating final gravity and ABV: it raises both original and final gravity, but is not attenuated.  If this field is absent, 100% should be assumed.\n\nTypical values are 0% for lactose and around 10% for maltodextrin, which is mostly dextrins with a little glucose and maltose.\n\nThis is a property of the ingredient, not of the beer, and is intended for ingredients that are wholly or largely unfermentable.  Do not set it for ordinary malts, as the attenuation figures quoted for yeasts already allow for the unfermentable dextrins in a normal all-malt wort.  (By contrast, `fermentability` is the typical apparent attenuation of a wort made from the ingredient, and so already includes the effect of the yeast.)\n\nNote that some organisms (eg some *Brettanomyces* strains and lactic acid bacteria) can ferment sugars that brewing yeast cannot, so a recipe using them may attenuate further than this value implies.",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    },
    "beta_glucan": {
      "description": "β-glucan content, as given on a malt analysis sheet, ie measured in a Congress (standard laboratory) wort, typically in mg/L. High values (roughly 180 mg/L or more) indicate a risk of high wort viscosity and slow lautering, so a β-glucan rest and avoiding fly sparging may be worth considering.\n\nThis field is normally only meaningful for *malted* grains.",
      "$ref": "Measurement.beer.schema#/$defs/MassFractionOrConcentration"
    },
    "lactic_acid_by_weight": {
      "description": "For acidulated malts (aka acid malts), this is the percentage content by weight of lactic acid (which is usually what provides the acidity).  You might think that maltsters would be keen to give you this figure, but they often prefer to say things such as \"1% of this malt in the grain bill reduces the mash pH by approximately 0.1\", which is less helpful.  According to https://www.brunwater.com/water-knowledge, \"The typical acid content of acid malt can vary from maltster to maltster.  A range of 2 to 3 percent by weight lactic acid to acidulated grain weight is typical.\"",
      "$ref": "Measurement.beer.schema#/$defs/PercentageSimple"
    }
  },
  "required": [
    "name",
    "fermentable_type",
    // Normally you want at least one of "yield_fine_grind", "yield_coarse_grind", "yield_fine_coarse_difference", "yield_potential"
    "color"
  ],
  //
  // See https://json-schema.org/understanding-json-schema/reference/conditionals#dependentSchemas for how the
  // "dependentSchemas" keyword works.  Essentially, it allows us to enforce that `grain_group` only be set if
  // `fermentable_type` is `grain`.
  //
  "dependentSchemas": {
    "grain_group": { "properties": { "fermentable_type": { "const": "grain" } } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "FermentableAmount" : {
      "description": "The ways in which an amount of a Fermentable could be measured",
      "oneOf": [
        {
          "$ref": "Measurement.beer.schema#/$defs/Volume"
        },
        {
          "$ref": "Measurement.beer.schema#/$defs/Mass"
        }
      ]
    }
  }
}