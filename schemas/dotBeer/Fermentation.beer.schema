{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Fermentation.beer.schema",
  "type": "object",
  "description": "A fermentation procedure, which can be used by multiple recipes.",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "fermentation_description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "fermentation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/FermentationStep"
      }
    }
  },
  "required": [
    "name",
    "fermentation_steps"
  ],
  "$defs": {
    "FermentationStep": {
      "type": "object",
      "description": "Individual step of a fermentation.",
      "allOf": [
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepBase"
        },
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepWithGravity"
        },
        {
          "properties": {
            "free_rise": {
              "description": "Free rise is used to indicate a fermentation step where the exothermic fermentation is allowed to raise the temperature without restriction This is either True or false.",
              "type": "boolean"
            },
            "vessel": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "name"
      ]
    }
  }
}