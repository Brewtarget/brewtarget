{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/0.10.0/Boil.beer.schema",
  "type": "object",
  "description": "A boil procedure, which can be used by multiple recipes.  A boil procedure with no steps is the same as a standard single step boil.",
  "properties": {
    "name": {
      "type": "string"
    },
    "local_id" : {
      "description": "The \"local ID\" that allows other objects in this file (eg recipes) to refer to this boil.",
      "$ref": "DotBeer.beer.schema#/$defs/LocalId"
    },
    "folder_path": {
      "description": "The suggested slash-delimited subfolder path in which to store this Boil object.",
      "$ref": "DotBeer.beer.schema#/$defs/FolderPath"
    },
    "boil_description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pre_boil_size": {
      "description": "Volume of wort at the start of the boil.",
      "$ref": "Measurement.beer.schema#/$defs/Volume"
    },
    //
    // BeerJSON has an extra field, "boil_time" which I _think_ is mostly a hangover from BeerXML (which doesn't model
    // boil steps).  BeerJSON allows boil_steps to be empty, in which case, the boil is a "standard single-step boil".
    // We take the view that it's simpler and more consistent to insist that boil steps be present and not empty (as is
    // the case for mash_steps and fermentation_steps).  This means we can calculate boil time from the steps rather
    // than storing it separately, so we remove the "boil_time" field in dotBeer.
    //
    // (In theory, we could allow boil_time when boil_steps is not present, to imitate BeerXML.  But, in reality, what
    // happens, when we read BeerXML, is that we create some default boil steps, based on its BOIL_TIME field, so, in
    // this newer format, we might as well insist on the steps.)
    //
    "boil_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/BoilStep"
      }
    }
  },
  "required": [
    "name",
    "boil_steps"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "BoilStep": {
      "type": "object",
      "description": "Individual step of a boil, including preboil steps, non-boiling pasteurization steps, boiling, whirlpool steps, and chilling.",
      "allOf": [
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepBase"
        },
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepWithRampTime"
        },
        {
          "$ref": "StepCommon.beer.schema#/$defs/StepWithGravity"
        },
        {
          "properties": {
            "chilling_type": {
              "description": "Chilling type separates batch chilling, eg immersion chillers, where the entire volume of wort is brought down in temperature as a whole, vs inline chilling where the wort is chilled while it is being drained, which can leave a significant amount of hop isomerization occurring in the boil kettle.",
              "type": "string",
              "enum": [
                "batch",
                "inline"
              ]
            }
          }
        }
      ],
      "required": [
        "name"
      ],
      "unevaluatedProperties": false
    }
  }
}