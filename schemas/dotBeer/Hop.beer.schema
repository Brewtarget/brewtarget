{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbeer.org/schema/Hop.beer.schema",
  "type": "object",
  "title": "Hop",
  "description": "Full definition of a hop variety.",
  "allOf": [
    {
      "$ref": "#/$defs/HopBase"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "aroma",
            "bittering",
            "flavor",
            "aroma/bittering",
            "bittering/flavor",
            "aroma/flavor",
            "aroma/bittering/flavor"
          ]
        },
        "notes": {
          "type": "string"
        },
        "six_month_alpha_loss": {
          "description": " Defined as the percentage of hop alpha lost in 6 months of storage.",
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "substitutes": {
          "type": "string",
          "description": "Alternate hop varieties that can be used in place of this hop variety"
        },
        "oil_content": {
          "$ref": "#/$defs/OilContent"
        },
        "inventory": {
          "$ref": "#/$defs/HopInventory"
        }
      }
    }
  ],
  "$defs": {
    "HopBase": {
      "type": "object",
      "title": "Base Hop Record",
      "description": "Minimal properties to identify individual records of a hop variety.",
      "properties": {
        "name": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "description": "Country of origin for the hop variety"
        },
        "year": {
          "type": "string",
          "description": "Year of harvest.  (Note that this is intentionally not a number, as, for one thing, years are not generally formatted in the same way as numbers.)"
        },
        "form": {
          "enum": [
            "extract",
            "leaf",
            "leaf (wet)",
            "pellet",
            "powder",
            "plug"
          ]
        },
        "alpha_acid": {
          "description": "The actual alpha acid content of the specific year's harvest (and batch) of this type of hop.",
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "alpha_acid_range": {
          "description": "The typical range of alpha acid for this type of hop.",
          "$ref": "Measurement.beer.schema#/$defs/RangeOfPercentage"
        },
        "beta_acid": {
          "description": "The actual beta acid content of the specific year's harvest (and batch) of this type of hop.",
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "beta_acid_range": {
          "description": "The typical range of beta acid for this type of hop.",
          "$ref": "Measurement.beer.schema#/$defs/RangeOfPercentage"
        }
      },
      "required": [
        "name",
        "alpha_acid"
      ]
    },
    "HopInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "oneOf": [
            {
              "$ref": "Measurement.beer.schema#/$defs/Volume"
            },
            {
              "$ref": "Measurement.beer.schema#/$defs/Mass"
            }
          ]
        }
      }
    },
    "OilContent": {
      "type": "object",
      "description": "Collects all information of a hop variety pertaining to oil content, polyphenols, and thiols. Each individual compound is expressed as a percent of the total oil measurement.",
      "properties": {
        "total_oil_ml_per_100g": {
          "description": "The total amount of oil, including hydrocarbons, esters, and terpene alcohols in units of ml of oil per 100g of hop mass.",
          "type": "number"
        },
        "humulene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "caryophyllene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "cohumulone": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "myrcene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "farnesene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "geraniol": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "b_pinene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "linalool": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "limonene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "nerol": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "pinene": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "polyphenols": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        },
        "xanthohumol": {
          "$ref": "Measurement.beer.schema#/$defs/Percentage"
        }
      }
    }
  }
}