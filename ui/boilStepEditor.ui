<?xml version="1.0" encoding="UTF-8"?>
<ui version="6.0">
 <class>boilStepEditor</class>
 <widget class="QDialog" name="boilStepEditor">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>476</width>
    <height>182</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Boil Step Editor</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QGridLayout" name="gridLayout">
     <item row="0" column="1">
      <widget class="QLabel" name="label_name">
       <property name="text">
        <string>Name</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_name</cstring>
       </property>
      </widget>
     </item>
     <item row="0" column="2" colspan="4">
      <widget class="QLineEdit" name="lineEdit_name">
       <property name="toolTip">
        <string>Name</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="SmartLabel" name="label_startTemp">
       <property name="contextMenuPolicy">
        <enum>Qt::CustomContextMenu</enum>
       </property>
       <property name="text">
        <string>Start temp.</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_startTemp</cstring>
       </property>
      </widget>
     </item>
     <item row="2" column="2">
      <widget class="SmartLineEdit" name="lineEdit_startTemp">
       <property name="toolTip">
        <string>Temperature at the start of this step.  If not set, the wort is assumed to be boiling.  Steps are classified as pre-boil, boil proper or post-boil by their temperatures.  For IBU formulae that model isomerization after flameout (eg mIBU and SMPH), a post-boil step that starts at boiling and ends below it is modelled as the wort cooling naturally (down to, but not below, the end temperature); any other post-boil step is modelled as the temperature changing linearly from the start temperature to the end temperature (so eg a hop stand held at 80°C (176°F) has start and end temperatures of 80°C).</string>
       </property>
      </widget>
     </item>
     <item row="2" column="4">
      <widget class="SmartLabel" name="label_stepTime">
       <property name="contextMenuPolicy">
        <enum>Qt::CustomContextMenu</enum>
       </property>
       <property name="text">
        <string>Time</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_stepTime</cstring>
       </property>
      </widget>
     </item>
     <item row="2" column="5">
      <widget class="SmartLineEdit" name="lineEdit_stepTime">
       <property name="toolTip">
        <string>How long this step lasts, not including any ramp time.  For a post-boil step (eg whirlpool or hop stand), hops added to this step with no time set steep for this long (plus the time of any subsequent steps).</string>
       </property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="SmartLabel" name="label_endTemp">
       <property name="contextMenuPolicy">
        <enum>Qt::CustomContextMenu</enum>
       </property>
       <property name="text">
        <string>End temp.</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_endTemp</cstring>
       </property>
      </widget>
     </item>
     <item row="4" column="2">
      <widget class="SmartLineEdit" name="lineEdit_endTemp">
       <property name="toolTip">
        <string>Temperature at the end of this step.  If not set, the wort is assumed to be boiling.</string>
       </property>
      </widget>
     </item>
     <item row="4" column="4">
      <widget class="SmartLabel" name="label_rampTime">
       <property name="contextMenuPolicy">
        <enum>Qt::CustomContextMenu</enum>
       </property>
       <property name="text">
        <string>Temp. lag time</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_rampTime</cstring>
       </property>
      </widget>
     </item>
     <item row="4" column="5">
      <widget class="SmartLineEdit" name="lineEdit_rampTime">
       <property name="toolTip">
        <string>Ramp time: how long it takes, before this step begins, to get from the end temperature of the previous step to the start temperature of this one.  Eg, for a hop stand at 80°C (176°F), the time taken to chill the wort from boiling to that temperature.  For post-boil steps, the temperature is modelled as changing linearly during the ramp, and hops added to the step with no time set are added at the end of the ramp.  If not set, any temperature change between steps is treated as instantaneous.</string>
       </property>
      </widget>
     </item>
     <item row="6" column="1">
      <widget class="QLabel" name="label_boilStepChillingType">
       <property name="text">
        <string>Chilling Type</string>
       </property>
       <property name="buddy">
        <cstring>comboBox_boilStepChillingType</cstring>
       </property>
      </widget>
     </item>
     <item row="6" column="2">
      <widget class="BtComboBoxEnum" name="comboBox_boilStepChillingType">
       <property name="toolTip">
        <string>Chilling Type</string>
       </property>
      </widget>
     </item>
     <item row="8" column="1">
      <widget class="SmartLabel" name="label_startGravity">
       <property name="text">
        <string>Start Gravity</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_startGravity</cstring>
       </property>
      </widget>
     </item>
     <item row="8" column="2">
      <widget class="SmartLineEdit" name="lineEdit_startGravity">
      </widget>
     </item>
     <item row="8" column="4">
      <widget class="SmartLabel" name="label_startAcidity">
       <property name="text">
        <string>Start Acidity</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_startAcidity</cstring>
       </property>
      </widget>
     </item>
     <item row="8" column="5">
      <widget class="SmartLineEdit" name="lineEdit_startAcidity">
      </widget>
     </item>
     <item row="10" column="1">
      <widget class="SmartLabel" name="label_endGravity">
       <property name="text">
        <string>End Gravity</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_endGravity</cstring>
       </property>
      </widget>
     </item>
     <item row="10" column="2">
      <widget class="SmartLineEdit" name="lineEdit_endGravity">
      </widget>
     </item>
     <item row="10" column="4">
      <widget class="SmartLabel" name="label_endAcidity">
       <property name="text">
        <string>End Acidity</string>
       </property>
       <property name="buddy">
        <cstring>lineEdit_endAcidity</cstring>
       </property>
      </widget>
     </item>
     <item row="10" column="5">
      <widget class="SmartLineEdit" name="lineEdit_endAcidity">
      </widget>
     </item>
     <item row="12" column="1">
      <widget class="QLabel" name="label_description">
       <property name="toolTip">
        <string>Optional description of this boil step</string>
       </property>
       <property name="text">
        <string>Description</string>
       </property>
       <property name="buddy">
        <cstring>textEdit_description</cstring>
       </property>
      </widget>
     </item>
     <item row="12" column="2" colspan="4">
      <widget class="QTextEdit" name="textEdit_description">
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <property name="spacing">
      <number>2</number>
     </property>
     <item>
      <widget class="QPushButton" name="pushButton_new">
       <property name="toolTip">
        <string>New</string>
       </property>
       <property name="text">
        <string>New</string>
       </property>
       <property name="icon">
        <iconset resource="../resources.qrc">
         <normaloff>:/images/smallPlus.svg</normaloff>:/images/smallPlus.svg</iconset>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_save">
       <property name="toolTip">
        <string>Save and close</string>
       </property>
       <property name="text">
        <string>Save</string>
       </property>
       <property name="icon">
        <iconset resource="../resources.qrc">
         <normaloff>:/images/filesave.svg</normaloff>:/images/filesave.svg</iconset>
