<?xml version="1.0" encoding="UTF-8"?>
<ui version="6.0">
 <class>mashEditor</class>
 <widget class="QDialog" name="mashEditor">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>482</width>
    <height>240</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Mash Editor</string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="LockAndShareBar" name="lockAndShareBar"/>
   </item>
   <item>
    <widget class="QTabWidget" name="tabWidget_editor">
     <property name="tabPosition">
      <enum>QTabWidget::West</enum>
     </property>
     <property name="currentIndex">
      <number>0</number>
     </property>
     <property name="usesScrollButtons">
      <bool>false</bool>
     </property>
     <widget class="QWidget" name="tab_main">
      <attribute name="title">
       <string>Main</string>
      </attribute>

      <layout class="QGridLayout" name="gridLayoutMain">
       <item row="0" column="1">
        <widget class="QLabel" name="label_name">
         <property name="text">
          <string>Name</string>
         </property>
        </widget>
       </item>
       <item row="0" column="2" colspan="4">
        <widget class="QLineEdit" name="lineEdit_name">
         <property name="toolTip">
          <string>Name</string>
         </property>
        </widget>
       </item>

       <item row="2" column="1">
        <widget class="SmartLabel" name="label_grainTemp">
         <property name="text">
          <string>Initial grain temp</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_grainTemp</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="2">
        <widget class="SmartLineEdit" name="lineEdit_grainTemp">
         <property name="toolTip">
          <string>Initial grain temp</string>
         </property>
        </widget>
       </item>

       <item row="8" column="1" colspan="5">
         <widget class="MashStepsWidget" name="enumeratedItemsWidget">
         </widget>
       </item>

       <item row="9" column="1" colspan="5">
        <widget class="QLabel" name="label_mashProblems">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="textFormat">
          <enum>Qt::RichText</enum>
         </property>
        </widget>
       </item>

       <item row="10" column="1">
        <widget class="SmartLabel" name="label_totalMashWater">
         <property name="text">
          <string>Total Mash Water</string>
         </property>
        </widget>
       </item>
       <item row="10" column="2">
        <widget class="SmartValueDisplay" name="value_totalMashWater">
        </widget>
       </item>
       <item row="10" column="4">
        <widget class="SmartLabel" name="label_totalTime">
         <property name="text">
          <string>Total Time</string>
         </property>
        </widget>
       </item>
       <item row="10" column="5">
        <widget class="SmartValueDisplay" name="value_totalTime">
        </widget>
       </item>

       <item row="11" column="1" colspan="5">
        <widget class="QGroupBox" name="groupBox_calculate">
         <property name="title">
          <string>Adjust water amounts and temperatures</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_calculate">
          <item row="0" column="0">
           <widget class="QLabel" name="label_spargeMethod">
            <property name="text">
             <string>Sparge</string>
            </property>
            <property name="buddy">
             <cstring>comboBox_spargeMethod</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="comboBox_spargeMethod">
            <property name="toolTip">
             <string>How the grain will be rinsed after the mash.  Changing this and clicking Auto-Adjust replaces any existing sparge steps.</string>
            </property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel" name="label_numBatches">
            <property name="text">
             <string>Batches</string>
            </property>
            <property name="buddy">
             <cstring>spinBox_numBatches</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="3">
           <widget class="QSpinBox" name="spinBox_numBatches">
            <property name="toolTip">
             <string>Number of batch sparges</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>5</number>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="SmartLabel" name="label_thickness">
            <property name="text">
             <string>Mash thickness</string>
            </property>
            <property name="buddy">
             <cstring>lineEdit_thickness</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="SmartLineEdit" name="lineEdit_thickness">
            <property name="toolTip">
             <string>Volume of strike water per mass of grain (not counting any water that sits below the grain bed).  Most often around 2.5 to 3.2 L/kg (1.2 to 1.5 qt/lb).  Not used if there is no sparge, as then all the water goes in the mash.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="3">
           <widget class="QPushButton" name="pushButton_autoAdjust">
            <property name="toolTip">
             <string>Change the amounts and temperatures of the strike water and other infusions, the amounts of any decoctions, and the amounts and temperatures of sparge water, to suit this recipe's grain bill and equipment.  Values you have pinned in a step are not changed.</string>
            </property>
            <property name="text">
             <string>Auto-Adjust</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0" colspan="4">
           <widget class="QCheckBox" name="checkBox_keptInSync">
            <property name="toolTip">
             <string>Available when mash is used by exactly one recipe.  Keep mash in sync with recipe by doing an auto-adjust whenever changes happen, eg to the recipe's grain bill or equipment.  (Changing the steps themselves does not trigger an adjustment, so pin any values you want to keep.)</string>
            </property>
            <property name="text">
             <string>Keep mash in sync with recipe changes</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0" colspan="4">
           <widget class="QLabel" name="label_calculateInfo">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="textFormat">
             <enum>Qt::RichText</enum>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item row="13" column="0">
        <widget class="InfoButton" name="infoButton_id"></widget>
       </item>
       <item row="13" column="1">
        <widget class="QLabel" name="label_id">
         <property name="text">
          <string>ID in database</string>
         </property>
        </widget>
       </item>
       <item row="13" column="2">
        <widget class="QLabel" name="label_id_value">
        </widget>
       </item>

       <item row="13" column="4" colspan="2">
        <widget class="QLabel" name="label_numRecipesUsing">
        </widget>
       </item>

       <item row="14" column="1" colspan="5">
        <widget class="InfoText" name="infoText_id">
         <property name="buddy">
          <cstring>infoButton_id</cstring>
         </property>
         <property name="text">
          <string>You can normally ignore this, but it's sometimes useful for debugging.</string>
         </property>
        </widget>
       </item>

      </layout>
     </widget>

     <widget class="QWidget" name="tab_legacy">
      <attribute name="title">
       <string>Legacy</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayoutLegacy">
       <item row="0" column="1" colspan="5">
        <widget class="QLabel" name="label_legacyTabInfo">
         <property name="text">
          <string>These are old settings that still work but might be retired in a future version of the software as there are now other ways to achieve the same same result.</string>
         </property>
        </widget>
       </item>

       <item row="2" column="0">
        <widget class="InfoButton" name="infoButton_tunTemp"></widget>
       </item>
       <item row="2" column="1">
        <widget class="SmartLabel" name="label_tunTemp">
         <property name="text">
          <string>Initial tun temp</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_tunTemp</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="2">
        <widget class="SmartLineEdit" name="lineEdit_tunTemp">
         <property name="text">
          <string>Name</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1" colspan="5">
        <widget class="InfoText" name="infoText_tunTemp">
         <property name="buddy">
          <cstring>infoButton_tunTemp</cstring>
         </property>
         <property name="text">
          <string>Initial temperature of the mash tun.  Used when calculating the strike water temperature, to allow for the strike water heating up the mash tun.  If left blank, the tun is assumed to be at the same temperature as the grain.</string>
         </property>
        </widget>
       </item>

       <item row="4" column="0">
        <widget class="InfoButton" name="infoButton_spargeTemp"></widget>
       </item>
       <item row="4" column="1">
        <widget class="SmartLabel" name="label_spargeTemp">
         <property name="contextMenuPolicy">
          <enum>Qt::CustomContextMenu</enum>
         </property>
         <property name="text">
          <string>Sparge temp</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_spargeTemp</cstring>
         </property>
        </widget>
       </item>
       <item row="4" column="2">
        <widget class="SmartLineEdit" name="lineEdit_spargeTemp">
         <property name="toolTip">
          <string>Sparge temp target</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1" colspan="5">
        <widget class="InfoText" name="infoText_spargeTemp">
         <property name="buddy">
          <cstring>infoButton_spargeTemp</cstring>
         </property>
         <property name="text">
          <string>Used as the target grain bed temperature for new sparge steps when adjusting the mash.  It is better to set this on the sparge step itself.</string>
         </property>
        </widget>
       </item>

       <item row="6" column="0">
        <widget class="InfoButton" name="infoButton_spargePh"></widget>
       </item>
       <item row="6" column="1">
        <widget class="SmartLabel" name="label_spargePh">
         <property name="text">
          <string>Sparge pH</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_spargePh</cstring>
         </property>
        </widget>
       </item>
       <item row="6" column="2">
        <widget class="SmartLineEdit" name="lineEdit_spargePh">
         <property name="toolTip">
          <string>Sparge pH</string>
         </property>
        </widget>
       </item>
       <item row="7" column="1" colspan="5">
        <widget class="InfoText" name="infoText_spargePh">
         <property name="buddy">
          <cstring>infoButton_spargePh</cstring>
         </property>
         <property name="text">
          <string>It is better to set this on the sparge step itself.</string>
         </property>
        </widget>
       </item>

       <item row="8" column="0">
        <widget class="InfoButton" name="infoButton_tunMass"></widget>
       </item>
       <item row="8" column="1">
        <widget class="SmartLabel" name="label_tunMass">
         <property name="text">
          <string>Tun mass</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_tunMass</cstring>
         </property>
        </widget>
       </item>
       <item row="8" column="2">
        <widget class="SmartLineEdit" name="lineEdit_tunMass">
         <property name="toolTip">
          <string>Tun mass</string>
         </property>
        </widget>
       </item>
       <item row="9" column="1" colspan="5">
        <widget class="InfoText" name="infoText_tunMass">
         <property name="buddy">
          <cstring>infoButton_tunMass</cstring>
         </property>
         <property name="text">
          <string>It is better to set this on the Equipment (Mash Tun tab).  This value is only used if the recipe's equipment has a mash tun with no weight and specific heat set.  It is ignored if the equipment has no separate mash tun (ie the mash happens in the kettle), because the strike water is then heated in the same vessel as the mash.</string>
         </property>
        </widget>
       </item>

       <item row="10" column="0">
        <widget class="InfoButton" name="infoButton_tunSpHeat"></widget>
       </item>
       <item row="10" column="1">
        <widget class="SmartLabel" name="label_tunSpHeat">
         <property name="text">
          <string>Tun specific heat</string>
         </property>
         <property name="buddy">
          <cstring>lineEdit_tunSpHeat</cstring>
         </property>
        </widget>
       </item>
       <item row="10" column="2">
        <widget class="SmartLineEdit" name="lineEdit_tunSpHeat">
         <property name="toolTip">
          <string>Tun specific heat (cal/(g*K))</string>
         </property>
        </widget>
       </item>
       <item row="11" column="1" colspan="5">
        <widget class="InfoText" name="infoText_tunSpHeat">
         <property name="buddy">
          <cstring>infoButton_tunSpHeat</cstring>
         </property>
         <property name="text">
          <string>It is better to set this on the Equipment (Mash Tun tab).  This value is only used if the recipe's equipment has a mash tun with no weight and specific heat set.  It is ignored if the equipment has no separate mash tun (ie the mash happens in the kettle), because the strike water is then heated in the same vessel as the mash.</string>
         </property>
        </widget>
       </item>

      </layout>

     </widget>

     <widget class="QWidget" name="tab_notes">
      <attribute name="title">
       <string>Notes</string>
      </attribute>
      <layout class="QHBoxLayout" name="horizontalLayout_2">
       <item>
        <widget class="QTextEdit" name="textEdit_notes"/>
       </item>
      </layout>
     </widget>

    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_Buttons">
     <property name="spacing">
      <number>2</number>
     </property>
     <item>
      <spacer name="horizontalSpacer_Buttons">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_new">
       <property name="toolTip">
        <string>New</string>
       </property>
       <property name="text">
        <string>New</string>
       </property>
       <property name="icon">
        <iconset resource="../resources.qrc">
         <normaloff>:/images/smallPlus.svg</normaloff>:/images/smallPlus.svg</iconset>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_save">
       <property name="toolTip">
        <string>Save and close</string>
       </property>
       <property name="text">
        <string>Save</string>
       </property>
       <property name="icon">
        <iconset resource="../resources.qrc">
         <normaloff>:/images/filesave.svg</normaloff>:/images/filesave.svg</iconset>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_cancel">
       <property name="toolTip">
        <string>Discard and close</string>
       </property>
       <property name="text">
        <string>Cancel</string>
       </property>
       <property name="icon">
        <iconset resource="../resources.qrc">
         <normaloff>:/images/exit.svg</normaloff>:/images/exit.svg</iconset>
