<?xml version="1.0" encoding="UTF-8"?>
<ui version="6.0">
 <class>optionsDialog</class>
 <widget class="QDialog" name="optionsDialog">
  <property name="enabled">
   <bool>true</bool>
  </property>
  <property name="windowTitle">
   <string>Options</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_3">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="tabPosition">
      <enum>QTabWidget::North</enum>
     </property>
     <property name="tabShape">
      <enum>QTabWidget::Rounded</enum>
     </property>
     <property name="currentIndex">
      <number>0</number>
     </property>
     <!-- ========================================= Units & Precision tab ========================================== -->
     <widget class="QWidget" name="tab_units">
      <attribute name="title">
       <string>Units &amp;&amp; Precision</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_units">
       <!--
          Row 0 is the column headings.  The rows for each Measurement::PhysicalQuantity are generated in code (see
          OptionDialog::impl::configure_unitCombos()), which also moves the Date row below them.  Date lives on this
          tab because it doesn't have a better home, but it is not a PhysicalQuantity, so is hard-coded, and has
          nothing in the decimal places column.
       -->
       <item row="0" column="1">
        <widget class="QLabel" name="label_unitSystemHeading">
         <property name="text">
          <string>Units</string>
         </property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QLabel" name="label_decimalPlacesHeading">
         <property name="text">
          <string>Decimal places</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="dateLabel">
         <property name="text">
          <string>Date</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QComboBox" name="dateComboBox">
         <property name="minimumSize">
          <size>
           <width>200</width>
           <height>0</height>
          </size>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- ============================================== Formulas tab ============================================== -->
     <widget class="QWidget" name="tab_formula">
      <property name="enabled">
       <bool>true</bool>
      </property>
      <attribute name="title">
       <string>Formulas</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item>
        <widget class="QGroupBox" name="groupBox_4">
         <property name="title">
          <string>Formulas</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_formulas" columnstretch="0,0,1">
          <item row="0" column="0">
           <widget class="InfoButton" name="infoButton_ibuFormula"></widget>
          </item>
          <item row="0" column="1">
           <widget class="QLabel" name="ibuFormulaLabel">
            <property name="text">
             <string>IBU</string>
            </property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="BtComboBoxEnum" name="ibuFormulaComboBox"/>
          </item>
          <item row="1" column="1" colspan="2">
           <widget class="InfoText" name="infoText_ibuFormula">
            <property name="buddy">
             <cstring>infoButton_ibuFormula</cstring>
            </property>
            <property name="text">
             <string>How bitterness (IBUs) is estimated from the recipe's hop additions.
 • Tinseth: the most widely used formula.  Allows for boil time and wort gravity.
 • Rager: older; generally gives higher IBUs than Tinseth.
 • Noonan: from Greg Noonan's "New Brewing Lager Beer".
 • Garetz: from Mark Garetz's "Using Hops".  Generally lower IBUs, none for 10 minutes' boil or less, and allows for high hopping rates.
 • Daniels: from Ray Daniels' "Designing Great Beers".  Separate figures for pellets and whole hops.
 • mIBU: John-Paul Hosom's extension of Tinseth, adding bitterness from hops in hot wort after flameout.
 • SMPH: Hosom's detailed model, which also allows for oxidized alpha acids, polyphenols, hopping rate, wort pH and yeast flocculation.
Only mIBU and SMPH give IBUs for hops added after flameout (eg whirlpool), using the post-boil steps of the boil profile.  For formulas other than Garetz, Daniels and SMPH, pellets are assumed to give 10% more IBUs than whole hops (plugs 2%).</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLabel" name="colorFormulaLabel">
            <property name="text">
             <string>Color</string>
            </property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="BtComboBoxEnum" name="colorFormulaComboBox"/>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_2">
         <property name="title">
          <string>IBU Adjustments</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_ibuAdjustments" columnstretch="0,0,1">
          <item row="0" column="0">
           <widget class="InfoButton" name="infoButton_mashHop"></widget>
          </item>
          <item row="0" column="1">
           <widget class="QLabel" name="mashHopLabel_2">
            <property name="text">
             <string>Mash Hop (%)</string>
            </property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QDoubleSpinBox" name="ibuAdjustmentMashHopDoubleSpinBox">
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="maximum">
             <double>200.000000000000000</double>
            </property>
            <property name="singleStep">
             <double>5.000000000000000</double>
            </property>
            <property name="value">
             <double>100.000000000000000</double>
            </property>
           </widget>
          </item>
          <item row="1" column="1" colspan="2">
           <widget class="InfoText" name="infoText_mashHop">
            <property name="buddy">
             <cstring>infoButton_mashHop</cstring>
            </property>
            <property name="text">
             <string>IBUs from hops added to the mash, as a percentage of what the same hops would give if they were added at the start of the boil and boiled for its full length.  Mash hops contribute little or no bitterness, because alpha acids isomerize very slowly at mash temperatures and much of the hop material stays behind with the grain.  The default is 0%, ie mash hops are assumed to give no IBUs.  This applies whichever IBU formula is selected.</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="InfoButton" name="infoButton_firstWort"></widget>
          </item>
          <item row="2" column="1">
           <widget class="QLabel" name="firstWortLabel">
            <property name="text">
             <string>First Wort (%)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="QDoubleSpinBox" name="ibuAdjustmentFirstWortDoubleSpinBox">
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="maximum">
             <double>200.000000000000000</double>
            </property>
            <property name="singleStep">
             <double>5.000000000000000</double>
            </property>
            <property name="value">
             <double>100.000000000000000</double>
            </property>
           </widget>
          </item>
          <item row="3" column="1" colspan="2">
           <widget class="InfoText" name="infoText_firstWort">
            <property name="buddy">
             <cstring>infoButton_firstWort</cstring>
            </property>
            <property name="text">
             <string>IBUs from first wort hops (hops put in the kettle as the wort is run off, before the boil starts), as a percentage of what the same hops would give if they were added at the start of the boil.  The default of 110% reflects the commonly reported finding that first wort hopping gives about 10% more bitterness than a full-length boil addition.  This applies whichever IBU formula is selected.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
