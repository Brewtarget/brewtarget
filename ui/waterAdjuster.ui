<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>waterAdjuster</class>
 <widget class="QWidget" name="waterAdjuster">
  <!--property name="windowTitle">
   <string>Water Profile Adjustment Tool</string>
  </property-->
  <layout class="QVBoxLayout" name="verticalLayout_4">
   <item>
    <widget class="QSplitter" name="splitter_vertical_recipe">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <!--
     ================================================= Left-hand panel =================================================
      -->
     <widget class="QWidget" name="panel_left" native="true">
      <layout class="QVBoxLayout" name="verticalLayout_left" stretch="0,0,0">
       <item>
        <layout class="QGridLayout" name="gridLayout_profiles">
         <item row="1" column="0">
          <widget class="QLabel" name="label_baseProfile">
           <property name="text">
            <string>Base Profile</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1" colspan="4">
          <widget class="BtComboBoxWater" name="combo_waterBase">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Preferred">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize">
            <size>
             <width>128</width>
             <height>0</height>
            </size>
           </property>
          </widget>
         </item>
         <item row="1" column="5">
          <widget class="QPushButton" name="pushButton_editBaseProfile">
           <property name="toolTip">
            <string>Edit base water profile</string>
           </property>
           <property name="icon">
            <iconset resource="../resources.qrc">
             <normaloff>:/images/edit.svg</normaloff>:/images/edit.svg</iconset>
           </property>
          </widget>
         </item>

         <item row="3" column="0">
          <widget class="QLabel" name="label_mashRO">
           <property name="text">
            <string>% RO in Mash</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="spinBox_mashRO">
           <property name="maximum">
            <number>100</number>
           </property>
          </widget>
         </item>

         <item row="3" column="3">
          <widget class="QLabel" name="label_spargeRO">
           <property name="text">
            <string>% RO in Sparge</string>
           </property>
          </widget>
         </item>
         <item row="3" column="4">
          <widget class="QSpinBox" name="spinBox_spargeRO">
           <property name="maximum">
            <number>100</number>
           </property>
          </widget>
         </item>

         <item row="5" column="0">
          <widget class="QLabel" name="label_targetProfile">
           <property name="text">
            <string>Target Profile</string>
           </property>
          </widget>
         </item>
         <item row="5" column="1" colspan="4">
          <widget class="BtComboBoxWater" name="combo_waterTarget">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Preferred">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize">
            <size>
             <width>128</width>
             <height>0</height>
            </size>
           </property>
          </widget>
         </item>
         <item row="5" column="5">
          <widget class="QPushButton" name="pushButton_editTargetProfile">
           <property name="toolTip">
            <string>Edit target water profile</string>
           </property>
           <property name="icon">
            <iconset resource="../resources.qrc">
             <normaloff>:/images/edit.svg</normaloff>:/images/edit.svg</iconset>
           </property>
          </widget>
         </item>

        </layout>

       </item>
       <item>
        <widget class="QGroupBox" name="groupbox_actual">
         <property name="sizePolicy">
          <sizepolicy hsizetype="MinimumExpanding" vsizetype="Preferred">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title">
          <string>Actual</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_ppm" rowstretch="0,0,0,0">
          <item row="1" column="1">
           <widget class="SmartLabel" name="label_ca">
            <property name="text">
             <string>Ca</string>
            </property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="SmartDigitWidget" name="btDigit_ca">
           </widget>
          </item>

          <item row="1" column="3">
           <spacer name="horizontalSpacer_1">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>

          <item row="1" column="4">
