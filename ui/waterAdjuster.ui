            </property>
           </widget>
          </item>
          <item row="1" column="8">
           <widget class="SmartDigitWidget" name="btDigit_na">
           </widget>
          </item>

          <item row="3" column="1">
           <widget class="SmartLabel" name="label_cl">
            <property name="text">
