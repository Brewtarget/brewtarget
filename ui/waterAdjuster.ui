        </widget>
       </item>

       <item>
        <widget class="BtTabWidget" name="tabWidget_adjustments">
         <widget class="QWidget" name="tab_waterAgents">
          <attribute name="title">
           <string>Water Agents (Miscellaneous)</string>
          </attribute>
          <layout class="QHBoxLayout" name="horizontalLayout_waterAgents">
           <item>
            <widget class="QTableView" name="tableView_waterAgents">
             <property name="alternatingRowColors">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QVBoxLayout" name="verticalLayout_waterAgentButtons">
             <property name="spacing">
              <number>1</number>
             </property>
             <item>
              <widget class="QPushButton" name="pushButton_addWaterAgent">
               <property name="toolTip">
                <string>Add a water agent</string>
               </property>
               <property name="text">
                <string/>
               </property>
               <property name="icon">
                <iconset resource="../resources.qrc">
                 <normaloff>:/images/smallPlus.svg</normaloff>:/images/smallPlus.svg</iconset>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="pushButton_removeWaterAgent">
               <property name="toolTip">
                <string>Remove selected water agent</string>
               </property>
               <property name="text">
                <string/>
               </property>
               <property name="icon">
                <iconset resource="../resources.qrc">
                 <normaloff>:/images/smallMinus.svg</normaloff>:/images/smallMinus.svg</iconset>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>

         <widget class="QWidget" name="tab_acidMalts">
          <attribute name="title">
           <string>Acid Malts (Fermentables)</string>
          </attribute>
          <layout class="QHBoxLayout" name="horizontalLayout_acidMalts">
           <item>
            <widget class="QTableView" name="tableView_acidMalts">
             <property name="alternatingRowColors">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QVBoxLayout" name="verticalLayout_acidMaltButtons">
             <property name="spacing">
              <number>1</number>
