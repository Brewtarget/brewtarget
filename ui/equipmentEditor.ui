       <item row="3" column="0">
        <widget class="InfoButton" name="infoButton_lauterTunDeadspaceLoss"></widget>
       </item>
       <item row="3" column="1">
        <widget class="SmartLabel" name="label_lauterTunDeadspaceLoss">
         <property name="contextMenuPolicy">
          <enum>Qt::CustomContextMenu</enum>
         </property>
         <property name="text">
