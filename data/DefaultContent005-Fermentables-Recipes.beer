      {
        "name": "Hallertauer Tradition",
        "hop_type": "aroma",
        "origin": "Germany",
        "folder_path": "Germany",
        "alpha_acid": {
          "unit": "%",
          "value": 5.7
        },
        "alpha_acid_range": {
          "minimum": {
