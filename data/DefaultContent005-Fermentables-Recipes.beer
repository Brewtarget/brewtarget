      {
        "name": "Zumo",
        "hop_type": "aroma",
        "origin": "United States",
        "folder_path": "United States",
        "alpha_acid": {
          "unit": "%",
          "value": 6.0
        },
        "alpha_acid_range": {
          "minimum": {
