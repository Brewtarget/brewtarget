      {
        "name": "Green Bullet",
        "hop_type": "aroma/bittering",
        "origin": "New Zealand",
        "folder_path": "New Zealand",
        "alpha_acid": {
          "unit": "%",
          "value": 12.5
        },
        "alpha_acid_range": {
          "minimum": {
            "unit": "%",
            "value": 10.4
          },
          "maximum": {
            "unit": "%",
            "value": 13.5
          }
        },
        "beta_acid": {
