      {
        "name": "Korsta",
        "hop_type": "aroma/bittering",
        "origin": "Sweden",
        "folder_path": "Sweden",
        "alpha_acid": {
          "unit": "%",
          "value": 8.0
        },
        "alpha_acid_range": {
          "minimum": {
            "unit": "%",
