    "styles": [
      {
        "name": "Saison",
        "local_id": "Style_210",
        "folder_path": "Canadian Homebrewers Association",
        "category": "Strong Belgian Ale",
        "category_number": "25",
        "style_letter": "B",
        "style_guide": "BJCP 2015",
        "style_type": "beer",
        "original_gravity": {
          "minimum": {
            "unit": "sg",
            "value": 1.048
          },
          "maximum": {
            "unit": "sg",
            "value": 1.065
          }
        },
        "final_gravity": {
          "minimum": {
            "unit": "sg",
            "value": 1.002
          },
          "maximum": {
