      {
        "name": "Northdown",
        "hop_type": "aroma/bittering",
        "origin": "United States",
        "folder_path": "United States",
        "alpha_acid": {
          "unit": "%",
          "value": 8.5
        },
        "alpha_acid_range": {
          "minimum": {
            "unit": "%",
            "value": 6.0
          },
          "maximum": {
            "unit": "%",
            "value": 9.6
          }
        },
        "beta_acid": {
          "unit": "%",
