// EXPECT-INVALID: /DotBeer/miscs/0: 'water_agent_type' is a required property
// EXPECT-INVALID: /DotBeer/miscs/1/misc_type: 'water agent' was expected
// EXPECT-INVALID: /DotBeer/miscs/2/water_agent_type: 'calcium sulfate' is not one of
//
// Breaks each of the water-agent rules in Misc.beer.schema:
//  0. misc_type "water agent" without a water_agent_type
//  1. water_agent_type on something that is not a water agent
//  2. water_agent_percent_acid on a salt
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-16T10:00:00Z",
    "miscs": [
      { "name": "Mystery Salt", "local_id": "m0", "misc_type": "water agent" },
      { "name": "Irish Moss", "local_id": "m1", "misc_type": "fining", "water_agent_type": "other" },
      {
        "name": "Acidic Gypsum?",
        "local_id": "m2",
        "misc_type": "water agent",
        "water_agent_type": "calcium sulfate",
        "water_agent_percent_acid": { "unit": "%", "value": 50 }
      }
    ]
  }
}