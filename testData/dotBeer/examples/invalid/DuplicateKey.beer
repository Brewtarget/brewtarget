// EXPECT-INVALID: duplicate key "alpha_acid" in object
//
// An object with the same key twice.  Plain JSON (RFC 8259) only says names SHOULD be unique, and parsers differ over
// which value they keep (eg Boost.JSON and Python keep the last, some others keep the first), so dotBeer forbids
// duplicate keys outright.  Schema validation cannot catch this, as it only sees the parsed result.
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-22T18:00:00Z",
    "hops": [
      {
        "name": "Cascade",
        "local_id": "hop_cascade",
        "alpha_acid": { "unit": "%", "value": 5.5 },
        "alpha_acid": { "unit": "%", "value": 7.0 }
      }
    ]
  }
}
