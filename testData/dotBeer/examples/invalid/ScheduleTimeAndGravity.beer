// EXPECT-INVALID: /DotBeer/recipes/0/ingredients/hop_additions/0/schedule: {
// EXPECT-INVALID: should not be valid under
//
// `time`, `specific_gravity` and `pH` are alternative ways of saying when an addition happens, so at most one may be
// set.  Here a dry hop sets both a time and a gravity.
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-16T10:00:00Z",
    "hops": [
      { "name": "Citra", "local_id": "hop_citra", "alpha_acid": { "unit": "%", "value": 12.0 } }
    ],
    "fermentables": [
      { "name": "Pale Malt", "local_id": "ferm_pale", "fermentable_type": "grain", "color": { "unit": "EBC", "value": 5 }, "yield_fine_grind": { "unit": "%", "value": 80.0 } }
    ],
    "recipes": [
      {
        "name": "Over-Specified Dry Hop",
        "recipe_type": "all grain",
        "author": "A. Brewer",
        "batch_size": { "unit": "l", "value": 20 },
        "efficiency": { "brewhouse": { "unit": "%", "value": 70 } },
        "ingredients": {
          "fermentable_additions": [
            { "fermentable_id": "ferm_pale", "schedule": { "stage": "add_to_mash" }, "amount": { "unit": "kg", "value": 4 } }
          ],
          "hop_additions": [
            {
              "hop_id": "hop_citra",
              "schedule": {
                "stage": "add_to_fermentation",
                "time": { "unit": "day", "value": 3 },
                "specific_gravity": { "unit": "sg", "value": 1.018 }
              },
              "amount": { "unit": "g", "value": 50 }
            }
          ]
        }
      }
    ]
  }
}