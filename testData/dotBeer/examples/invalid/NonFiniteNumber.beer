// EXPECT-INVALID: NaN is not valid JSON (numbers must be finite)
//
// NaN, Infinity and -Infinity are not valid JSON, although some parsers (eg Python's json module by default) accept
// them.  They are not allowed in dotBeer files.
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-22T18:00:00Z",
    "hops": [
      { "name": "Cascade", "local_id": "hop_cascade", "alpha_acid": { "unit": "%", "value": NaN } }
    ]
  }
}
