// EXPECT-INVALID: Illegal trailing comma before end of array
//
// Some JSONC parsers allow a trailing comma after the last item in an array or object, but dotBeer does not.
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-22T18:00:00Z",
    "hops": [
      { "name": "Cascade", "local_id": "hop_cascade", "alpha_acid": { "unit": "%", "value": 5.5 } },
    ]
  }
}
