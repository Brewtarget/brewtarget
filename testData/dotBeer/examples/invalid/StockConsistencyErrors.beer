// EXPECT-INVALID: /DotBeer/hop_stock_purchases/0 ("Reversed dates"): date_received 2026-04-01 is before date_ordered 2026-04-06
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/1/stock_uses/0: date 2026-03-30 is before the purchase's date_received 2026-04-06
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/2/stock_uses/0: date 2026-10-01 is before the purchase's date_ordered 2026-10-15
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/3 ("Mixed measures"): amounts must all be the same kind of measure, but there is a mix of mass, volume
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/3/
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/4 ("Used by volume"): amounts must all be the same kind of measure, but there is a mix of mass, volume
// EXPECT-INVALID: /DotBeer/hop_stock_purchases/4/
// EXPECT-INVALID: /DotBeer/fermentable_stock_purchases/0 ("Used too much"): stock uses total 5.5 kg, which is more than the 5 kg of amount_received
// EXPECT-INVALID: /DotBeer/misc_stock_purchases/0 ("Not yet received"): stock uses total 3 count, which is more than the 2 count of amount_ordered
//
// Stock purchase errors, most of which JSON Schema can't catch, and that validate.py checks instead:
//   • stock received before it was ordered
//   • stock used before it was received
//   • stock used before it was ordered (where it hasn't been received)
//   • a purchase ordered by mass but received by volume (which the schema does catch, but validate.py gives a clearer
//     message)
//   • a purchase received by mass but used by volume (ditto)
// (The "/3/" and "/4/" expectations above are just the paths of the schema errors for these last two, as which part of
// the schema the validator blames for a failed "anyOf" is a matter of heuristics.)
//   • uses (in different units of mass) adding up to more than was received
//   • uses adding up to more than was ordered (where nothing has been received)
// The last purchase is valid: its uses add up to exactly what was received, but in different units.
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-21T19:30:00Z",
    "hops": [
      { "name": "Cascade", "local_id": "hop_cascade", "alpha_acid": { "unit": "%", "value": 6.4 } }
    ],
    "fermentables": [
      { "name": "Pale Malt", "local_id": "ferm_pale", "fermentable_type": "grain", "color": { "unit": "EBC", "value": 5 }, "yield_fine_grind": { "unit": "%", "value": 80.0 } }
    ],
    "miscs": [
      { "name": "Whirlfloc", "local_id": "misc_whirlfloc", "misc_type": "fining" }
    ],
    "hop_stock_purchases": [
      {
        // ERROR: received before it was ordered
        "name": "Reversed dates",
        "hop_id": "hop_cascade",
        "date_ordered": "2026-04-06",
        "date_received": "2026-04-01",
        "amount_received": { "unit": "g", "value": 100 }
      },
      {
        "name": "Used before received",
        "hop_id": "hop_cascade",
        "date_received": "2026-04-06",
        "amount_received": { "unit": "g", "value": 100 },
        "stock_uses": [
          // ERROR: before date_received
          { "date": "2026-03-30", "reason": "used", "amount_used": { "unit": "g", "value": 30 } }
        ]
      },
      {
        "name": "Used before ordered",
        "hop_id": "hop_cascade",
        "date_ordered": "2026-10-15",
        "amount_ordered": { "unit": "g", "value": 100 },
        "stock_uses": [
          // ERROR: not received, and before date_ordered
          { "date": "2026-10-01", "reason": "lost", "amount_used": { "unit": "g", "value": 10 } }
        ]
      },
      {
        // ERROR: ordered by mass, received by volume
        "name": "Mixed measures",
        "hop_id": "hop_cascade",
        "date_received": "2026-04-06",
        "amount_ordered": { "unit": "g", "value": 100 },
        "amount_received": { "unit": "l", "value": 1 }
      },
      {
        // ERROR: received by mass, but used by volume
        "name": "Used by volume",
        "hop_id": "hop_cascade",
        "date_received": "2026-04-06",
        "amount_received": { "unit": "g", "value": 100 },
        "stock_uses": [
          { "date": "2026-05-09", "reason": "used", "amount_used": { "unit": "l", "value": 0.1 } }
        ]
      }
    ],
    "fermentable_stock_purchases": [
      {
        // ERROR: 4.5 kg + 1000 g = 5.5 kg, but only 5 kg received
        "name": "Used too much",
        "fermentable_id": "ferm_pale",
        "date_received": "2026-04-08",
        "amount_received": { "unit": "kg", "value": 5 },
        "stock_uses": [
          { "date": "2026-05-09", "reason": "used", "amount_used": { "unit": "kg", "value": 4.5 } },
          { "date": "2026-06-15", "reason": "lost", "amount_used": { "unit": "g", "value": 1000 } }
        ]
      },
      {
        // Valid: 1 lb + 8 oz = 1.5 lb, all used
        "name": "Used exactly",
        "fermentable_id": "ferm_pale",
        "date_received": "2026-04-08",
        "amount_received": { "unit": "lb", "value": 1.5 },
        "stock_uses": [
          { "date": "2026-05-09", "reason": "used", "amount_used": { "unit": "lb", "value": 1 } },
          { "date": "2026-05-10", "reason": "used", "amount_used": { "unit": "oz", "value": 8 } }
        ]
      }
    ],
    "misc_stock_purchases": [
      {
        // ERROR: nothing received, and 3 used but only 2 ordered
        "name": "Not yet received",
        "misc_id": "misc_whirlfloc",
        "date_ordered": "2026-04-01",
        "amount_ordered": { "unit": "count", "value": 2 },
        "stock_uses": [
          { "date": "2026-05-09", "reason": "used", "amount_used": { "unit": "count", "value": 3 } }
        ]
      }
    ]
  }
}
