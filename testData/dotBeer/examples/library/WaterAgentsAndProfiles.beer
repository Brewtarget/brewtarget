//
// An ingredient library with no recipes, as might be exported to share a brewer's water setup.  It contains one misc
// for every `water_agent_type`, including the ones that need `water_agent_percent_acid`, plus some classic water
// profiles.  (The profiles are approximate, rounded figures of the kind commonly quoted in brewing literature.)
//
{
  "DotBeer": {
    "version": "1.0.0",
    "output_by": "DotBeer examples (hand-written)",
    "timestamp": "2026-10-16T10:00:00.250+02:00",

    "miscs": [
